  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  risk           Risk    @relation(fields: [riskId], references: [id], onDelete: Restrict)
  linkedByUser   User    @relation("ProblemRiskLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?   @relation("ProblemRiskLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([problemId, unlinkedAt])
  @@map("problem_risk_links")
}

model ProblemIncidentLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  problemId        String    @map("problem_id") @db.Uuid
  incidentId       String    @map("incident_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Restrict)
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  linkedByUser   User     @relation("ProblemIncidentLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?    @relation("ProblemIncidentLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([problemId, unlinkedAt])
  @@index([incidentId, unlinkedAt])
  @@map("problem_incident_links")
}


enum IndicatorMetricKey {
  RISK_TOTAL_BY_LEVEL
  RISK_TREATMENT_OVERDUE_COUNT
  CONTROL_INACTIVE_COUNT
  COMPLIANCE_PERCENTAGE
  AUDIT_ENGAGEMENT_OPEN_COUNT
  FINDING_OPEN_COUNT_BY_SEVERITY
  ASSET_INACTIVE_COUNT
  PROCESS_INACTIVE_COUNT
  ACTION_OVERDUE_COUNT
  INCIDENT_OPEN_COUNT_BY_SEVERITY
  PROBLEM_OPEN_COUNT_BY_SEVERITY
}

enum IndicatorThresholdComparator {
  GTE
  GT
  LTE
  LT
}

model IndicatorDefinition {
  id                  String                        @id @default(uuid(7)) @db.Uuid
  code                String                        @unique
  metricKey           IndicatorMetricKey            @unique @map("metric_key")
  name                String
  description         String
  ownerUserId         String                        @map("owner_user_id") @db.Uuid
  thresholdComparator IndicatorThresholdComparator? @map("threshold_comparator")
  thresholdValue      Decimal?                      @map("threshold_value") @db.Decimal
  isActive            Boolean                       @default(true) @map("is_active")
  createdByUserId     String                        @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User @relation("IndicatorDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("IndicatorDefinitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("indicator_definitions")
}

model IndicatorMeasurement {
  id               String             @id @default(uuid(7)) @db.Uuid
  metricKey        IndicatorMetricKey @map("metric_key")
  value            Decimal?           @db.Decimal
  valueByBucket    Json?              @map("value_by_bucket")
  breached         Boolean
  computedAt       DateTime           @default(now()) @map("computed_at") @db.Timestamptz(6)
  computedByUserId String             @map("computed_by_user_id") @db.Uuid

  computedByUser User @relation("IndicatorMeasurementComputedBy", fields: [computedByUserId], references: [id], onDelete: Restrict)

  @@index([metricKey, computedAt])
  @@map("indicator_measurements")
}

model ReportDefinition {
  id              String               @id @default(uuid(7)) @db.Uuid
  code            String               @unique
  name            String
  description     String
  metricKeys      IndicatorMetricKey[] @default([]) @map("metric_keys")
  isActive        Boolean              @default(true) @map("is_active")
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User @relation("ReportDefinitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("report_definitions")
}
