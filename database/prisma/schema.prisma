generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DATABASE_MIGRATION_URL")
  extensions = [citext, pg_trgm]
}


enum UserStatus {
  ACTIVE
  INACTIVE
}

enum AuthenticationMethod {
  LOCAL
  LDAP
  ACTIVE_DIRECTORY
  OIDC
  SAML
}

enum SessionRevocationReason {
  LOGOUT
  EXPIRED
  ADMIN_REVOKED
  USER_DEACTIVATED
  PASSWORD_CHANGED
}

enum PermissionAction {
  VIEW
  CREATE
  EDIT
  DELETE
  APPROVE
  ADMINISTER
  ASSESS
  TREAT
  TRANSITION
  LINK
  CLOSE
}

enum OrgUnitStatus {
  ACTIVE
  INACTIVE
}

enum OrgScopeType {
  UNIT
  GLOBAL
}

enum AuditEntityType {
  USER
  LOCAL_CREDENTIAL
  EXTERNAL_IDENTITY
  SESSION
  PERMISSION
  ROLE
  ROLE_PERMISSION
  USER_ROLE
  ORGANIZATIONAL_UNIT
  ORG_SCOPE_GRANT
  RISK
  RISK_ASSESSMENT
  RISK_METHODOLOGY_VERSION
  RISK_TREATMENT_DECISION
  RISK_TREATMENT_ACTION
  RISK_CONTROL_LINK
  RISK_PROCESS_LINK
  RISK_ASSET_LINK
  RISK_LIFECYCLE_TRANSITION
  APPROVAL
  ATTACHMENT
  COMMENT
  PROBE_RECORD
  EVIDENCE
  EVIDENCE_LINK
  ACTION
  FINDING
  CONTROL
  CONTROL_LIFECYCLE_TRANSITION
  CONTROL_ASSESSMENT
  CONTROL_PROCESS_LINK
  CONTROL_ASSET_LINK
  FRAMEWORK
  FRAMEWORK_VERSION
  REQUIREMENT
  REQUIREMENT_CONTROL_LINK
  REQUIREMENT_CONTROL_MAPPING_MIGRATION
  REQUIREMENT_APPLICABILITY
  REQUIREMENT_COMPLIANCE_STATE
  AUDIT_ENGAGEMENT
  AUDIT_SCOPE_FRAMEWORK_VERSION
  AUDIT_SCOPE_REQUIREMENT
  AUDIT_SCOPE_CONTROL
  FINDING_CONTROL_LINK
  FINDING_RISK_LINK
  ASSET
  PROCESS
  INCIDENT
  PROBLEM
  INCIDENT_RISK_LINK
  INCIDENT_ASSET_LINK
  INCIDENT_PROCESS_LINK
  PROBLEM_RISK_LINK
  PROBLEM_INCIDENT_LINK
  INDICATOR
  INDICATOR_MEASUREMENT
  REPORT
}


enum RiskStatus {
  DRAFT
  IDENTIFIED
  ASSESSED
  UNDER_TREATMENT
  UNDER_REVIEW
  ACCEPTED
  CLOSED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum TreatmentStrategy {
  MITIGATE
  AVOID
  TRANSFER
  ACCEPT
}


enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ApprovableEntityType {
  RISK
  CONTROL_ASSESSMENT
}

enum AttachableEntityType {
  RISK
  EVIDENCE
  INCIDENT
  PROBLEM
  PROBE_RECORD
}

enum CommentableEntityType {
  RISK
  INCIDENT
  PROBLEM
  INDICATOR
  PROBE_RECORD
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}


model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique @db.Citext
  fullName         String     @map("full_name")
  jobTitle         String?    @map("job_title")
  status           UserStatus @default(ACTIVE)
  primaryOrgUnitId String?    @map("primary_org_unit_id") @db.Uuid
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  primaryOrgUnit OrganizationalUnit? @relation("UserPrimaryOrgUnit", fields: [primaryOrgUnitId], references: [id], onDelete: Restrict)

  localCredential                   LocalCredential?
  externalIdentities                ExternalIdentity[]
  sessions                          Session[]
  userRoles                         UserRole[]                @relation("UserRoleAssignee")
  grantedUserRoles                  UserRole[]                @relation("UserRoleGrantedBy")
  orgScopeGrants                    OrgScopeGrant[]           @relation("OrgScopeGrantAssignee")
  grantedScopeGrants                OrgScopeGrant[]           @relation("OrgScopeGrantGrantedBy")
  auditEventsAsActor                AuditEvent[]              @relation("AuditEventActor")
  riskOwnerOf                       Risk[]                    @relation("RiskOwner")
  riskResponsibleOf                 Risk[]                    @relation("RiskResponsible")
  riskAssessmentsMade               RiskAssessment[]          @relation("RiskAssessmentAssessedBy")
  riskMethodologyVersionsPublished  RiskMethodologyVersion[]  @relation("RiskMethodologyVersionCreatedBy")
  riskTreatmentDecisionsDecided     RiskTreatmentDecision[]   @relation("RiskTreatmentDecisionDecidedBy")
  riskControlLinksLinked            RiskControlLink[]         @relation("RiskControlLinkLinkedBy")
  riskControlLinksUnlinked          RiskControlLink[]         @relation("RiskControlLinkUnlinkedBy")
  riskProcessLinksLinked            RiskProcessLink[]         @relation("RiskProcessLinkLinkedBy")
  riskProcessLinksUnlinked          RiskProcessLink[]         @relation("RiskProcessLinkUnlinkedBy")
  riskAssetLinksLinked              RiskAssetLink[]           @relation("RiskAssetLinkLinkedBy")
  riskAssetLinksUnlinked            RiskAssetLink[]           @relation("RiskAssetLinkUnlinkedBy")
  riskLifecycleTransitionsPerformed RiskLifecycleTransition[] @relation("RiskLifecycleTransitionPerformedBy")
  approvalsRequested                Approval[]                @relation("ApprovalRequestedBy")
  approvalsDecided                  Approval[]                @relation("ApprovalDecidedBy")
  attachmentsUploaded               Attachment[]              @relation("AttachmentUploadedBy")
  attachmentsWithdrawn              Attachment[]              @relation("AttachmentDeletedBy")
  commentsAuthored                  Comment[]                 @relation("CommentAuthor")
  commentsWithdrawn                 Comment[]                 @relation("CommentDeletedBy")
  notificationsReceived             Notification[]            @relation("NotificationRecipient")

  evidenceOwnerOf       Evidence[]     @relation("EvidenceOwner")
  evidenceArchivedBy    Evidence[]     @relation("EvidenceArchivedBy")
  evidenceLinksLinked   EvidenceLink[] @relation("EvidenceLinkLinkedBy")
  evidenceLinksUnlinked EvidenceLink[] @relation("EvidenceLinkUnlinkedBy")
  actionsResponsibleFor Action[]       @relation("ActionResponsible")
  actionsCompleted      Action[]       @relation("ActionCompletedBy")
  actionsReopened       Action[]       @relation("ActionReopenedBy")
  findingOwnerOf        Finding[]      @relation("FindingOwner")
  findingsClosed        Finding[]      @relation("FindingClosedBy")
  findingsArchived      Finding[]      @relation("FindingArchivedBy")

  controlOwnerOf                       Control[]                    @relation("ControlOwner")
  controlsRetired                      Control[]                    @relation("ControlRetiredBy")
  controlAssessmentsAssessed           ControlAssessment[]          @relation("ControlAssessmentAssessedBy")
  controlAssessmentsAttested           ControlAssessment[]          @relation("ControlAssessmentAttestedBy")
  controlProcessLinksLinked            ControlProcessLink[]         @relation("ControlProcessLinkLinkedBy")
  controlProcessLinksUnlinked          ControlProcessLink[]         @relation("ControlProcessLinkUnlinkedBy")
  controlAssetLinksLinked              ControlAssetLink[]           @relation("ControlAssetLinkLinkedBy")
  controlAssetLinksUnlinked            ControlAssetLink[]           @relation("ControlAssetLinkUnlinkedBy")
  controlLifecycleTransitionsPerformed ControlLifecycleTransition[] @relation("ControlLifecycleTransitionPerformedBy")

  frameworkVersionsPublished       FrameworkVersion[]                    @relation("FrameworkVersionPublishedBy")
  requirementsCreated              Requirement[]                         @relation("RequirementCreatedBy")
  requirementControlLinksLinked    RequirementControlLink[]              @relation("RequirementControlLinkLinkedBy")
  requirementControlLinksUnlinked  RequirementControlLink[]              @relation("RequirementControlLinkUnlinkedBy")
  mappingMigrationsExecuted        RequirementControlMappingMigration[]  @relation("MappingMigrationExecutedBy")
  applicabilityDeclarationsMade    RequirementApplicabilityDeclaration[] @relation("RequirementApplicabilityDeclaredBy")
  applicabilityDeclarationsRevoked RequirementApplicabilityDeclaration[] @relation("RequirementApplicabilityRevokedBy")

  auditEngagementsLed               AuditEngagement[]            @relation("AuditEngagementLeadAuditor")
  auditEngagementsStarted           AuditEngagement[]            @relation("AuditEngagementStartedBy")
  auditEngagementsCompleted         AuditEngagement[]            @relation("AuditEngagementCompletedBy")
  auditEngagementsCancelled         AuditEngagement[]            @relation("AuditEngagementCancelledBy")
  auditScopeFrameworkVersionsLinked AuditScopeFrameworkVersion[] @relation("AuditScopeFrameworkVersionLinkedBy")
  auditScopeRequirementsLinked      AuditScopeRequirement[]      @relation("AuditScopeRequirementLinkedBy")
  auditScopeControlsLinked          AuditScopeControl[]          @relation("AuditScopeControlLinkedBy")
  findingControlLinksLinked         FindingControlLink[]         @relation("FindingControlLinkLinkedBy")
  findingControlLinksUnlinked       FindingControlLink[]         @relation("FindingControlLinkUnlinkedBy")
  findingRiskLinksLinked            FindingRiskLink[]            @relation("FindingRiskLinkLinkedBy")
  findingRiskLinksUnlinked          FindingRiskLink[]            @relation("FindingRiskLinkUnlinkedBy")

  incidentReportedBy           Incident[]            @relation("IncidentReportedBy")
  incidentOwnerOf              Incident[]            @relation("IncidentOwner")
  incidentsResolved            Incident[]            @relation("IncidentResolvedBy")
  incidentsClosed              Incident[]            @relation("IncidentClosedBy")
  incidentsCancelled           Incident[]            @relation("IncidentCancelledBy")
  problemOwnerOf               Problem[]             @relation("ProblemOwner")
  problemsResolved             Problem[]             @relation("ProblemResolvedBy")
  problemsClosed               Problem[]             @relation("ProblemClosedBy")
  problemsCancelled            Problem[]             @relation("ProblemCancelledBy")
  incidentRiskLinksLinked      IncidentRiskLink[]    @relation("IncidentRiskLinkLinkedBy")
  incidentRiskLinksUnlinked    IncidentRiskLink[]    @relation("IncidentRiskLinkUnlinkedBy")
  incidentAssetLinksLinked     IncidentAssetLink[]   @relation("IncidentAssetLinkLinkedBy")
  incidentAssetLinksUnlinked   IncidentAssetLink[]   @relation("IncidentAssetLinkUnlinkedBy")
  incidentProcessLinksLinked   IncidentProcessLink[] @relation("IncidentProcessLinkLinkedBy")
  incidentProcessLinksUnlinked IncidentProcessLink[] @relation("IncidentProcessLinkUnlinkedBy")
  problemRiskLinksLinked       ProblemRiskLink[]     @relation("ProblemRiskLinkLinkedBy")
  problemRiskLinksUnlinked     ProblemRiskLink[]     @relation("ProblemRiskLinkUnlinkedBy")
  problemIncidentLinksLinked   ProblemIncidentLink[] @relation("ProblemIncidentLinkLinkedBy")
  problemIncidentLinksUnlinked ProblemIncidentLink[] @relation("ProblemIncidentLinkUnlinkedBy")

  indicatorDefinitionsOwned     IndicatorDefinition[]  @relation("IndicatorDefinitionOwner")
  indicatorDefinitionsCreated   IndicatorDefinition[]  @relation("IndicatorDefinitionCreatedBy")
  indicatorMeasurementsComputed IndicatorMeasurement[] @relation("IndicatorMeasurementComputedBy")
  reportDefinitionsCreated      ReportDefinition[]     @relation("ReportDefinitionCreatedBy")

  @@map("users")
}

model LocalCredential {
  id                 String    @id @default(uuid(7)) @db.Uuid
  userId             String    @unique @map("user_id") @db.Uuid
  passwordHash       String    @map("password_hash")
  passwordChangedAt  DateTime  @map("password_changed_at") @db.Timestamptz(6)
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  failedAttempts     Int       @default(0) @map("failed_attempts")
  lockedUntil        DateTime? @map("locked_until") @db.Timestamptz(6)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("local_credentials")
}

model ExternalIdentity {
  id              String               @id @default(uuid(7)) @db.Uuid
  userId          String               @map("user_id") @db.Uuid
  method          AuthenticationMethod
  externalSubject String               @map("external_subject")
  lastSyncedAt    DateTime?            @map("last_synced_at") @db.Timestamptz(6)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([method, externalSubject])
  @@map("external_identities")
}


model Session {
  id                   String                   @id @default(uuid(7)) @db.Uuid
  tokenHash            String                   @unique @map("token_hash")
  userId               String                   @map("user_id") @db.Uuid
  authenticationMethod AuthenticationMethod     @map("authentication_method")
  createdAt            DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  expiresAt            DateTime                 @map("expires_at") @db.Timestamptz(6)
  lastActivityAt       DateTime                 @map("last_activity_at") @db.Timestamptz(6)
  ipAddress            String?                  @map("ip_address") @db.Inet
  userAgent            String?                  @map("user_agent")
  revokedAt            DateTime?                @map("revoked_at") @db.Timestamptz(6)
  revokedReason        SessionRevocationReason? @map("revoked_reason")

  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([userId, revokedAt])
  @@index([expiresAt])
  @@map("sessions")
}


model Permission {
  id          String           @id @default(uuid(7)) @db.Uuid
  identifier  String           @unique
  resource    String
  action      PermissionAction
  description String
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]

  @@map("permissions")
}

model Role {
  id          String   @id @default(uuid(7)) @db.Uuid
  name        String   @unique
  description String
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Restrict)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Restrict)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId          String   @map("user_id") @db.Uuid
  roleId          String   @map("role_id") @db.Uuid
  grantedByUserId String   @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime @map("granted_at") @db.Timestamptz(6)

  user          User @relation("UserRoleAssignee", fields: [userId], references: [id], onDelete: Restrict)
  role          Role @relation(fields: [roleId], references: [id], onDelete: Restrict)
  grantedByUser User @relation("UserRoleGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@id([userId, roleId])
  @@map("user_roles")
}


model OrganizationalUnit {
  id        String        @id @default(uuid(7)) @db.Uuid
  code      String        @unique
  name      String
  parentId  String?       @map("parent_id") @db.Uuid
  path      String
  depth     Int
  status    OrgUnitStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   OrganizationalUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children OrganizationalUnit[] @relation("OrgUnitHierarchy")

  usersWithPrimaryUnit User[]              @relation("UserPrimaryOrgUnit")
  orgScopeGrants       OrgScopeGrant[]     @relation("OrgScopeGrantUnit")
  auditEvents          AuditEvent[]        @relation("AuditEventOrgUnit")
  risks                Risk[]              @relation("RiskOrgUnit")
  controls             Control[]           @relation("ControlOrgUnit")
  processes            Process[]           @relation("ProcessOrgUnit")
  assets               Asset[]             @relation("AssetOrgUnit")
  evidence             Evidence[]          @relation("EvidenceOrgUnit")
  actions              Action[]            @relation("ActionOrgUnit")
  findings             Finding[]           @relation("FindingOrgUnit")
  auditEngagements     AuditEngagement[]   @relation("AuditEngagementOrgUnit")
  controlAssessments   ControlAssessment[] @relation("ControlAssessmentOrgUnit")
  incidents            Incident[]          @relation("IncidentOrgUnit")
  problems             Problem[]           @relation("ProblemOrgUnit")

  @@index([parentId])
  @@index([path(ops: raw("text_pattern_ops"))], map: "organizational_units_path_pattern_idx")
  @@map("organizational_units")
}

model OrgScopeGrant {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  scopeType       OrgScopeType @map("scope_type")
  orgUnitId       String?      @map("org_unit_id") @db.Uuid
  grantedByUserId String       @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime     @map("granted_at") @db.Timestamptz(6)

  user          User                @relation("OrgScopeGrantAssignee", fields: [userId], references: [id], onDelete: Cascade)
  orgUnit       OrganizationalUnit? @relation("OrgScopeGrantUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  grantedByUser User                @relation("OrgScopeGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@map("org_scope_grants")
}

model PermissionCacheState {
  id                 String   @id @default("singleton")
  permissionsVersion Int      @default(1) @map("permissions_version")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("permission_cache_state")
}

model OrgScopeCacheState {
  id             String   @id @default("singleton")
  orgTreeVersion Int      @default(1) @map("org_tree_version")
  grantsVersion  Int      @default(1) @map("grants_version")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("org_scope_cache_state")
}


model AuditEvent {
  id                   String          @default(uuid(7)) @db.Uuid
  occurredAt           DateTime        @map("occurred_at") @db.Timestamptz(6)
  actorUserId          String?         @map("actor_user_id") @db.Uuid
  actorLabel           String          @map("actor_label")
  action               String
  entityType           AuditEntityType @map("entity_type")
  entityId             String?         @map("entity_id") @db.Uuid
  previousValues       Json?           @map("previous_values")
  newValues            Json?           @map("new_values")
  organizationalUnitId String?         @map("organizational_unit_id") @db.Uuid
  ipAddress            String?         @map("ip_address") @db.Inet
  userAgent            String?         @map("user_agent")
  sessionId            String?         @map("session_id") @db.Uuid
  correlationId        String          @map("correlation_id") @db.Uuid
  outcome              AuditOutcome

  actorUser          User?               @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  organizationalUnit OrganizationalUnit? @relation("AuditEventOrgUnit", fields: [organizationalUnitId], references: [id], onDelete: Restrict)

  @@id([id, occurredAt])
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "audit_event_entity_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_event_actor_idx")
  @@index([occurredAt(sort: Desc)], map: "audit_event_occurred_at_idx")
  @@map("audit_event")
}


model RiskCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  risks Risk[]

  @@map("risk_categories")
}

model RiskType {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  risks Risk[]

  @@map("risk_types")
}

model RiskOrigin {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  risks Risk[]

  @@map("risk_origins")
}

model RiskCodeSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("risk_code_sequences")
}

model Risk {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique
  title       String
  description String

  categoryId String? @map("category_id") @db.Uuid
  typeId     String? @map("type_id") @db.Uuid
  originId   String? @map("origin_id") @db.Uuid

  orgUnitId         String  @map("org_unit_id") @db.Uuid
  ownerUserId       String  @map("owner_user_id") @db.Uuid
  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  status RiskStatus @default(DRAFT)

  currentAssessmentId String? @map("current_assessment_id") @db.Uuid
  currentTreatmentId  String? @map("current_treatment_id") @db.Uuid
  pendingApprovalId   String? @map("pending_approval_id") @db.Uuid

  inherentScore Int?       @map("inherent_score")
  inherentLevel RiskLevel? @map("inherent_level")
  residualScore Int?       @map("residual_score")
  residualLevel RiskLevel? @map("residual_level")

  identifiedOn   DateTime  @map("identified_on") @db.Date
  lastAssessedOn DateTime? @map("last_assessed_on") @db.Date
  nextReviewOn   DateTime? @map("next_review_on") @db.Date

  version Int @default(0)

  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category          RiskCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type              RiskType?              @relation(fields: [typeId], references: [id], onDelete: Restrict)
  origin            RiskOrigin?            @relation(fields: [originId], references: [id], onDelete: Restrict)
  orgUnit           OrganizationalUnit     @relation("RiskOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  owner             User                   @relation("RiskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  responsible       User?                  @relation("RiskResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  currentAssessment RiskAssessment?        @relation("RiskCurrentAssessment", fields: [currentAssessmentId], references: [id], onDelete: Restrict)
  currentTreatment  RiskTreatmentDecision? @relation("RiskCurrentTreatment", fields: [currentTreatmentId], references: [id], onDelete: Restrict)
  pendingApproval   Approval?              @relation("RiskPendingApproval", fields: [pendingApprovalId], references: [id], onDelete: Restrict)

  causes               RiskCause[]
  consequences         RiskConsequence[]
  assessments          RiskAssessment[]          @relation("RiskAssessmentRisk")
  treatmentDecisions   RiskTreatmentDecision[]   @relation("RiskTreatmentDecisionRisk")
  treatmentActions     RiskTreatmentAction[]     @relation("RiskTreatmentActionRisk")
  controlLinks         RiskControlLink[]         @relation("RiskControlLinkRisk")
  processLinks         RiskProcessLink[]         @relation("RiskProcessLinkRisk")
  assetLinks           RiskAssetLink[]           @relation("RiskAssetLinkRisk")
  lifecycleTransitions RiskLifecycleTransition[] @relation("RiskLifecycleTransitionRisk")
  incidentLinks        IncidentRiskLink[]
  problemLinks         ProblemRiskLink[]
  findingLinks         FindingRiskLink[]

  @@index([orgUnitId, status])
  @@index([orgUnitId, residualLevel])
  @@index([orgUnitId, inherentLevel])
  @@index([orgUnitId, nextReviewOn])
  @@index([ownerUserId])
  @@index([categoryId])
  @@map("risks")
}

model RiskCause {
  id          String @id @default(uuid(7)) @db.Uuid
  riskId      String @map("risk_id") @db.Uuid
  description String
  sortOrder   Int    @map("sort_order")

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@map("risk_causes")
}

model RiskConsequence {
  id          String @id @default(uuid(7)) @db.Uuid
  riskId      String @map("risk_id") @db.Uuid
  description String
  sortOrder   Int    @map("sort_order")

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@map("risk_consequences")
}

model RiskMethodology {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions RiskMethodologyVersion[]

  @@map("risk_methodologies")
}

model RiskMethodologyVersion {
  id               String   @id @default(uuid(7)) @db.Uuid
  methodologyId    String   @map("methodology_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  probabilityScale Json     @map("probability_scale")
