{
  "name": "@pharos/api",
  "version": "0.1.0",
  "private": true,
  "description": "PharosGRC API — NestJS modular monolith",
  "license": "UNLICENSED",
  "type": "commonjs",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/src/main.js",
    "lint": "eslint \"src/**/*.ts\" \"test/**/*.ts\" \"seeds/**/*.ts\" --max-warnings=0 --no-error-on-unmatched-pattern",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:contract": "vitest run --config vitest.contract.config.ts",
    "db:generate": "node scripts/generate-prisma-client.mjs",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:seed:performance": "ts-node --transpile-only seeds/performance.seed.ts",
    "openapi:generate": "ts-node --transpile-only scripts/generate-openapi.ts",
    "openapi:check": "ts-node --transpile-only scripts/check-openapi.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.3",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.3",
    "@nestjs/platform-express": "11.2.3",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/throttler": "6.5.0",
    "@prisma/client": "6.19.3",
    "argon2": "^0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "6.0.0",
    "pino": "10.3.1",
    "pino-pretty": "13.1.3",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@nestjs/schematics": "11.1.0",
    "@nestjs/testing": "11.2.3",
    "@pharos/api-types": "workspace:*",
    "@swc/core": "1.16.2",
    "@types/express": "5.0.6",
    "@types/node": "22.20.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "dotenv": "17.4.2",
    "prisma": "6.19.3",
    "supertest": "7.2.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "unplugin-swc": "1.5.11",
    "vitest": "4.1.11",
    "yaml": "2.9.0"
  }
}
