{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["dom", "dom.iterable", "ES2023"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "allowJs": true,
    "noEmit": true,
    "incremental": true,
    "isolatedModules": true,
    "plugins": [{ "name": "next" }],
    "baseUrl": ".",
    // shadcn/ui's generated primitives in src/components/ui/ are kept
    // unmodified (plan.md) and are not written against
    // `exactOptionalPropertyTypes` (several Radix prop types assign
    // `T | undefined` to an optional `T` prop) — relaxed for this app only,
    // scoped to the one directory of vendored-by-convention source. Every
    // other strictness flag from tsconfig.base.json (strict,
    // noUncheckedIndexedAccess, noImplicitOverride, ...) still applies.
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./src/*"],
      "@pharos/design-system": ["./packages/design-system/src/index.ts"],
      "@pharos/design-system/*": ["./packages/design-system/src/*"],
      "@pharos/api-types": ["../packages/api-types/src/index.ts"],
      "@pharos/api-types/*": ["../packages/api-types/src/*"]
    }
  },
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
