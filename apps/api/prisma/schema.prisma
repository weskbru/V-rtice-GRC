// ---------------------------------------------------------------------------
// Core — Organizations (data-model.md §4)
// ---------------------------------------------------------------------------

/// `path` is maintained by the application inside the same transaction as
/// any insert or reparent (ADR-004); no database trigger maintains it.
model OrganizationalUnit {
  id        String        @id @default(uuid(7)) @db.Uuid
  code      String        @unique
  name      String
  parentId  String?       @map("parent_id") @db.Uuid
  path      String
  depth     Int
  status    OrgUnitStatus @default(ACTIVE)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  parent   OrganizationalUnit?  @relation("OrgUnitHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children OrganizationalUnit[] @relation("OrgUnitHierarchy")

  usersWithPrimaryUnit User[]              @relation("UserPrimaryOrgUnit")
  orgScopeGrants       OrgScopeGrant[]     @relation("OrgScopeGrantUnit")
  auditEvents          AuditEvent[]        @relation("AuditEventOrgUnit")
  risks                Risk[]              @relation("RiskOrgUnit")
  controls             Control[]           @relation("ControlOrgUnit")
  processes            Process[]           @relation("ProcessOrgUnit")
  assets               Asset[]             @relation("AssetOrgUnit")
  // GRC Shared Kernel (ADR-016, 002-shared-grc-foundation) — T005.
  evidence             Evidence[]          @relation("EvidenceOrgUnit")
  actions              Action[]            @relation("ActionOrgUnit")
  findings             Finding[]           @relation("FindingOrgUnit")
  // 005-audit-findings, T001 — AuditEngagement.orgUnitId (data-model.md §1).
  auditEngagements     AuditEngagement[]   @relation("AuditEngagementOrgUnit")
  // 007-implementation-remediation, D-11 — ControlAssessment.orgUnitId,
  // denormalized from Control.orgUnitId (see that field's own comment).
  controlAssessments   ControlAssessment[] @relation("ControlAssessmentOrgUnit")
  // 008-incidents-problems, foundation (data-model.md D-8) — `orgUnitId`
  // is a required, non-nullable column on both, following `Risk`/`Finding`,
  // not the nullable-column pattern `Asset`/`Process`/`Control` use.
  incidents            Incident[]          @relation("IncidentOrgUnit")
  problems             Problem[]           @relation("ProblemOrgUnit")

  @@index([parentId])
  // Prefix scans over the materialized path (ADR-004). text_pattern_ops is
  // required because the default btree opclass for text does not support
  // LIKE 'prefix%' index scans under a non-C collation.
  @@index([path(ops: raw("text_pattern_ops"))], map: "organizational_units_path_pattern_idx")
  @@map("organizational_units")
}

/// **Check** (enforced by raw SQL in the baseline migration — Prisma's
/// schema language has no `CHECK` attribute as of this Prisma version):
/// `(scopeType = 'GLOBAL' AND orgUnitId IS NULL) OR (scopeType = 'UNIT' AND orgUnitId IS NOT NULL)`.
model OrgScopeGrant {
  id              String       @id @default(uuid(7)) @db.Uuid
  userId          String       @map("user_id") @db.Uuid
  scopeType       OrgScopeType @map("scope_type")
  orgUnitId       String?      @map("org_unit_id") @db.Uuid
  grantedByUserId String       @map("granted_by_user_id") @db.Uuid
  grantedAt       DateTime     @map("granted_at") @db.Timestamptz(6)

  user          User                @relation("OrgScopeGrantAssignee", fields: [userId], references: [id], onDelete: Cascade)
  orgUnit       OrganizationalUnit? @relation("OrgScopeGrantUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  grantedByUser User                @relation("OrgScopeGrantGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)

  @@map("org_scope_grants")
}

/// Durable counter backing the RBAC effective-permission cache (ADR-003,
/// T036, `core/authorization/application/permission-resolver.service.ts`).
/// Single row, `id` fixed to the literal `"singleton"`.
///
/// Why a table instead of storing the counter itself inside `CacheProvider`
/// (which already exists for the resolved permission sets): `CacheProvider`
/// entries expire/get evicted independently of one another. If the counter
/// itself lived only in the cache and were evicted while an older,
/// unexpired permission-set entry survived under a key built from a lower
/// version number, the counter resetting back to that lower number (e.g.
/// after a cold cache) would make the stale entry look current again — the
/// exact "reused stale cache key" failure mode this design must avoid.
/// PostgreSQL is authoritative for the counter's value; only the *resolved*
/// permission sets are ever cached, keyed by `userId:permissionsVersion`.
model PermissionCacheState {
  id                 String   @id @default("singleton")
  permissionsVersion Int      @default(1) @map("permissions_version")
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("permission_cache_state")
}

/// Durable counters backing the organizational-scope cache (ADR-004, T039,
/// `core/organizations/application/scope-resolver.service.ts`). Same
/// rationale as `PermissionCacheState` above. Two independent counters
/// because a change to the org-unit tree (reparent, deactivate — bumps
/// `orgTreeVersion`) and a change to who holds a grant (`OrgScopeGrant`
/// create/revoke — bumps `grantsVersion`) are different events; both are
/// folded into one cache key (`userId:orgTreeVersion:grantsVersion`) so
/// either one changing still invalidates the cached resolved scope.
model OrgScopeCacheState {
  id             String   @id @default("singleton")
  orgTreeVersion Int      @default(1) @map("org_tree_version")
  grantsVersion  Int      @default(1) @map("grants_version")
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("org_scope_cache_state")
}

// ---------------------------------------------------------------------------
// Core — Audit (data-model.md §5) — append-only
// ---------------------------------------------------------------------------

/// Converted to a monthly `PARTITION BY RANGE (occurredAt)` table and made
/// append-only (privilege revocation + trigger) by hand-written SQL
/// migrations T027/T028, run after the migration this model produces. See
/// the file-level comment above for the drift this intentionally creates
/// between this model and the real table, and why.
///
/// The primary key is `(id, occurredAt)`, not `id` alone, because
/// PostgreSQL requires a partitioned table's primary key (and every unique
/// index) to include the partition key column.
model AuditEvent {
  id                   String          @default(uuid(7)) @db.Uuid
  occurredAt           DateTime        @map("occurred_at") @db.Timestamptz(6)
  actorUserId          String?         @map("actor_user_id") @db.Uuid
  actorLabel           String          @map("actor_label")
  action               String
  entityType           AuditEntityType @map("entity_type")
  entityId             String?         @map("entity_id") @db.Uuid
  previousValues       Json?           @map("previous_values")
  newValues            Json?           @map("new_values")
  organizationalUnitId String?         @map("organizational_unit_id") @db.Uuid
  ipAddress            String?         @map("ip_address") @db.Inet
  userAgent            String?         @map("user_agent")
  // Deliberately NOT a foreign key: sessions are cleaned up, audit is not.
  sessionId            String?         @map("session_id") @db.Uuid
  correlationId        String          @map("correlation_id") @db.Uuid
  outcome              AuditOutcome

  actorUser          User?               @relation("AuditEventActor", fields: [actorUserId], references: [id], onDelete: Restrict)
  organizationalUnit OrganizationalUnit? @relation("AuditEventOrgUnit", fields: [organizationalUnitId], references: [id], onDelete: Restrict)

  @@id([id, occurredAt])
  @@index([entityType, entityId, occurredAt(sort: Desc)], map: "audit_event_entity_idx")
  @@index([actorUserId, occurredAt(sort: Desc)], map: "audit_event_actor_idx")
  @@index([occurredAt(sort: Desc)], map: "audit_event_occurred_at_idx")
  @@map("audit_event")
}

// ---------------------------------------------------------------------------
// Risk Management — Configuration (data-model.md §7) — T084
// ---------------------------------------------------------------------------
//
// `RiskCategory`/`RiskType`/`RiskOrigin` are organization-configurable
// reference tables, "identical shape" per data-model.md §7: id, code
// (unique), name, description, sortOrder, isActive. Referenced from `Risk`
// with `ON DELETE RESTRICT` — in-use reference data is deactivated
// (`isActive = false`), never deleted (mirrors the platform-wide "anything
// historically relevant uses RESTRICT" convention already applied to
// `OrganizationalUnit`/`Permission`/`Role`).
//
// `RiskMethodology`/`RiskMethodologyVersion` (data-model.md §7's other
// subsection) are NOT included here — they belong to the Assessment story
// (US4, a later phase) and have no bearing on T079-T092's create/read/update
// of a risk's own record.

model RiskCategory {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  risks Risk[]

  @@map("risk_categories")
}

model RiskType {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  risks Risk[]

  @@map("risk_types")
}

model RiskOrigin {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  risks Risk[]

  @@map("risk_origins")
}

/// Durable per-year counter backing `RiskCodeGeneratorPort`
/// (`modules/risk/domain/ports/risk-code-generator.port.ts`, T087). Not named
/// anywhere in data-model.md — added here, following the same "durable
/// counter table" shape already established by `PermissionCacheState`/
/// `OrgScopeCacheState`, because FR-054's per-year human-readable code
/// (`RSK-2026-0001`) needs an atomically-incrementing counter somewhere, and
/// the restricted `pharos_app` role has no DDL privileges to create a native
/// PostgreSQL `SEQUENCE` per calendar year at runtime. See that port's
/// implementation (`infrastructure/prisma-risk-code-generator.ts`) for how a
/// plain `upsert` with `{ increment: 1 }` makes allocation race-free under
/// concurrent creates without needing `SELECT ... FOR UPDATE`.
model RiskCodeSequence {
  year      Int @id
  lastValue Int @default(0) @map("last_value")

  @@map("risk_code_sequences")
}

// ---------------------------------------------------------------------------
// Risk Management — The Risk Record (data-model.md §8) — T083
// ---------------------------------------------------------------------------
//
// ## Nullable `categoryId`, despite data-model.md §8's table not marking it
// ## nullable (interpretive decision, flagged in the implementation report)
//
// data-model.md §8 lists `categoryId` without an explicit "nullable" note
// (unlike `typeId`/`originId`, which are marked nullable), but FR-055/FR-056
// require a `DRAFT` risk to be saveable before it has a category, and
// `contracts/risks.openapi.yaml`'s `CreateRiskRequest.categoryId` is typed
// `[string, 'null']` and is absent from `required`. The authoritative
// contract — which a frontend agent is building against concurrently — wins
// this tension the same way D-7 resolved its own field-list disagreement:
// `categoryId` is nullable here.
//
// ## `currentAssessmentId`/`currentTreatmentId`/`pendingApprovalId`
//
// `currentAssessmentId` graduated to a real `@relation`/FK in the T120/US4
// migration (`RiskAssessment` now exists), and `currentTreatmentId` in the
// T139/US5 migration (`RiskTreatmentDecision` now exists) — see those
// models' own FK comments below. `pendingApprovalId` graduates the SAME way
// in THIS migration (T153/US6): `Approval` now exists, so the FK added by
// `20260905170100_risk_lifecycle_and_approvals_baseline` is expressed here
// too (`RESTRICT`, nullable) — see `Approval` below.
//
// ## The GIN trigram search index is NOT expressible here
//
// data-model.md §8 calls for "a GIN trigram index over
// `code || ' ' || title || ' ' || description`" — an expression index over a
// concatenation, which Prisma's schema language cannot declare (it only
// supports per-column index types, e.g. `@@index([field], type: Gin)`).
// Created instead by hand-written SQL in
// `prisma/migrations/20260905140100_risk_management_baseline/migration.sql`,
// the same documented drift pattern already established for `audit_event`'s
// partitioning (see this file's own header comment on that table).
model Risk {
  id          String @id @default(uuid(7)) @db.Uuid
  code        String @unique
  title       String
  description String

  categoryId String? @map("category_id") @db.Uuid
  typeId     String? @map("type_id") @db.Uuid
  originId   String? @map("origin_id") @db.Uuid

  orgUnitId         String  @map("org_unit_id") @db.Uuid
  ownerUserId       String  @map("owner_user_id") @db.Uuid
  responsibleUserId String? @map("responsible_user_id") @db.Uuid

  status RiskStatus @default(DRAFT)

  // `currentAssessmentId`/`currentTreatmentId`/`pendingApprovalId` all have
  // real FKs now (added below) — see this model's own header comment.
  currentAssessmentId String? @map("current_assessment_id") @db.Uuid
  currentTreatmentId  String? @map("current_treatment_id") @db.Uuid
  pendingApprovalId   String? @map("pending_approval_id") @db.Uuid

  inherentScore Int?       @map("inherent_score")
  inherentLevel RiskLevel? @map("inherent_level")
  residualScore Int?       @map("residual_score")
  residualLevel RiskLevel? @map("residual_level")

  identifiedOn   DateTime  @map("identified_on") @db.Date
  lastAssessedOn DateTime? @map("last_assessed_on") @db.Date
  nextReviewOn   DateTime? @map("next_review_on") @db.Date

  /// Optimistic lock (FR-103, ADR-013). Incremented on every mutation; every
  /// update statement is `WHERE id = ? AND version = ?`.
  version Int @default(0)

  /// FR-102 — risks are never hard-deleted; `CLOSED -> ARCHIVED`
  /// (`PerformTransitionUseCase`, T156, US6) is the only write path that
  /// ever sets this column.
  archivedAt DateTime? @map("archived_at") @db.Timestamptz(6)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  category          RiskCategory?          @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  type              RiskType?              @relation(fields: [typeId], references: [id], onDelete: Restrict)
  origin            RiskOrigin?            @relation(fields: [originId], references: [id], onDelete: Restrict)
  orgUnit           OrganizationalUnit     @relation("RiskOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  owner             User                   @relation("RiskOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  responsible       User?                  @relation("RiskResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  /// FR-065 pointer to the latest assessment (T120/US4). `RESTRICT`: an
  /// assessment can never be deleted out from under the risk it is the
  /// current pointer for — moot in practice since `RiskAssessment` has no
  /// delete path at all (append-only), but RESTRICT is still the correct
  /// declared intent per data-model.md §8/the platform's historical-data
  /// default (data-model.md's shared conventions).
  currentAssessment RiskAssessment?        @relation("RiskCurrentAssessment", fields: [currentAssessmentId], references: [id], onDelete: Restrict)
  /// FR-073 pointer to the latest (non-superseded) treatment decision
  /// (T139/US5). `RESTRICT` for the same reason as `currentAssessment`
  /// above — moot in practice since a treatment decision is never deleted
  /// (append-only), but it is the correct declared intent.
  currentTreatment  RiskTreatmentDecision? @relation("RiskCurrentTreatment", fields: [currentTreatmentId], references: [id], onDelete: Restrict)
  /// FR-029c pointer to the pending-approval CONDITION on this risk (T153/
  /// US6) — never a tenth lifecycle state (ADR-006). `RESTRICT` for the same
  /// reason as `currentAssessment`/`currentTreatment` above; moot in
  /// practice since an `Approval` row is never deleted, only decided once.
  pendingApproval   Approval?              @relation("RiskPendingApproval", fields: [pendingApprovalId], references: [id], onDelete: Restrict)

  causes               RiskCause[]
  consequences         RiskConsequence[]
  assessments          RiskAssessment[]          @relation("RiskAssessmentRisk")
  treatmentDecisions   RiskTreatmentDecision[]   @relation("RiskTreatmentDecisionRisk")
  treatmentActions     RiskTreatmentAction[]     @relation("RiskTreatmentActionRisk")
  controlLinks         RiskControlLink[]         @relation("RiskControlLinkRisk")
  processLinks         RiskProcessLink[]         @relation("RiskProcessLinkRisk")
  assetLinks           RiskAssetLink[]           @relation("RiskAssetLinkRisk")
  lifecycleTransitions RiskLifecycleTransition[] @relation("RiskLifecycleTransitionRisk")
  // 008-incidents-problems, foundation (data-model.md §2) — target side of
  // both link tables; simple unnamed back-relation, mirroring how `Control`
  // is the unnamed target side of `RiskControlLink` above.
  incidentLinks        IncidentRiskLink[]
  problemLinks         ProblemRiskLink[]
  /// 005-audit-findings, T003 — the `Finding <-> Risk` relationship Phase 1
  /// deferred (data-model.md §6, ADR-020 parts 1/2); `Risk` carries only the
  /// back-reference Prisma requires for the FK, owned by `grc/finding`.
  findingLinks         FindingRiskLink[]

  // Indexes derived from the register's actual access paths (data-model.md
  // §8, FR-087/FR-088/FR-089). The GIN trigram search index is hand-written
  // SQL — see the file-level comment above.
  @@index([orgUnitId, status])
  @@index([orgUnitId, residualLevel])
  @@index([orgUnitId, inherentLevel])
  @@index([orgUnitId, nextReviewOn])
  @@index([ownerUserId])
  @@index([categoryId])
  @@map("risks")
}

/// Individually recorded rows, not a free-text blob (FR-057, Constitution
/// I). `CASCADE` is correct: a cause has no meaning apart from its risk, and
/// its own lifecycle changes are carried by `audit_event` (data-model.md §8).
model RiskCause {
  id          String @id @default(uuid(7)) @db.Uuid
  riskId      String @map("risk_id") @db.Uuid
  description String
  sortOrder   Int    @map("sort_order")

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@map("risk_causes")
}

/// See `RiskCause` above — identical shape and rationale (FR-057).
model RiskConsequence {
  id          String @id @default(uuid(7)) @db.Uuid
  riskId      String @map("risk_id") @db.Uuid
  description String
  sortOrder   Int    @map("sort_order")

  risk Risk @relation(fields: [riskId], references: [id], onDelete: Cascade)

  @@index([riskId])
  @@map("risk_consequences")
}

// ---------------------------------------------------------------------------
// Risk Management — Configuration: Methodology (data-model.md §7) — T120/US4
// ---------------------------------------------------------------------------
//
// ## `createdAt`/`updatedAt` — literal field lists win here, extending the
// ## precedent T083 already set for `RiskCause`/`RiskConsequence`
//
// data-model.md §7's own field lists for `RiskMethodology`/
// `RiskMethodologyVersion` do not include `createdAt`/`updatedAt` (unlike
// `Risk` itself, which is a genuinely mutable, independently-meaningful
// entity and got them added anyway — see that model's own history). This
// schema follows the SAME resolution T083 already chose for `RiskCause`/
// `RiskConsequence` (also added after D-7, also omitted from D-7's own
// list): apply the literal field list from the relevant data-model.md
// section rather than re-opening the D-7 tension for every subsequent
// table, UNLESS the table is a genuinely mutable, independently-meaningful
// entity (in which case `Risk`'s own precedent — not D-7's original five —
// is the one that applies):
//
//   - `RiskMethodology` IS such an entity (`isActive` can flip when a second
//     methodology is introduced in a future phase) → `createdAt`/`updatedAt`
//     ADDED, matching `Risk`'s own precedent.
//   - `RiskMethodologyVersion` is **append-only** and already carries its
//     own semantic instant (`effectiveFrom`) — structurally identical to why
//     D-7 excluded `updatedAt` from `audit_event` ("a mutable `updatedAt` on
//     an immutable table would be incoherent") and, for the same reason
//     `audit_event.occurredAt` already IS the timestamp, a bare `createdAt`
//     would be redundant with `effectiveFrom` → NEITHER added.
//   - `RiskAssessment` (below) is likewise append-only; see that model's own
//     comment for why its case is not quite identical to `effectiveFrom`'s
//     but resolves the same way.
//
// ## `isActive` — exactly one active methodology
//
// data-model.md §7: "exactly one active, enforced by a partial unique
// index". Prisma's schema language has no partial/filtered index syntax (as
// of this Prisma version) — added by hand-written SQL in
// `20260905150100_risk_assessment_methodology_baseline/migration.sql`,
// exactly the same documented drift pattern as `audit_event`'s partitioning
// and `risks`' GIN trigram index (see those models' own header comments).
model RiskMethodology {
  id        String   @id @default(uuid(7)) @db.Uuid
  name      String
  isActive  Boolean  @default(false) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  versions RiskMethodologyVersion[]

  @@map("risk_methodologies")
}

/// **Append-only** (FR-068): a methodology change publishes a new version,
/// never updates an existing one. No update path exists in the application
/// for this model — see `methodology.controller.ts`/
/// `publish-methodology-version.usecase.ts`, which only ever `create`.
///
/// ## Enforcement: revoked privileges only, NOT a trigger (interpretive
/// ## decision — see the migration's own header for the full reasoning)
///
/// `audit_event`'s append-only guarantee (`20260905120200_audit_event_
/// append_only`) uses BOTH a `BEFORE UPDATE OR DELETE` trigger AND revoked
/// `UPDATE`/`DELETE` privileges, because `audit_event` must resist even the
/// OWNER role running an ad hoc statement by mistake (ADR-005 explicitly
/// treats it as the platform's single most safety-critical table). This
/// table's append-only guarantee is enforced by revoking `UPDATE`/`DELETE`
/// from the restricted application role ONLY (no trigger) — see the
/// migration's header comment for why that asymmetry is a deliberate,
/// justified choice for THIS table rather than an oversight.
///
/// `probabilityScale`/`impactScale`/`matrix`/`levelBands` are `jsonb` —
/// data-model.md §7: "JSONB is appropriate here (and only here in the risk
/// domain) because the scale shape is genuinely variable across
/// organizational methodologies; its structure is validated by a schema at
/// the application boundary" (`domain/methodology.schema.ts`, T121). Prisma
/// types a JSON column as `Json`; this schema does not attempt to model the
/// scale/matrix/band shape in SQL columns.
model RiskMethodologyVersion {
  id               String   @id @default(uuid(7)) @db.Uuid
  methodologyId    String   @map("methodology_id") @db.Uuid
  versionNumber    Int      @map("version_number")
  probabilityScale Json     @map("probability_scale")
  impactScale      Json     @map("impact_scale")
  matrix           Json
  levelBands       Json     @map("level_bands")
  effectiveFrom    DateTime @map("effective_from") @db.Timestamptz(6)
  createdByUserId  String   @map("created_by_user_id") @db.Uuid

  methodology   RiskMethodology @relation(fields: [methodologyId], references: [id], onDelete: Restrict)
  createdByUser User            @relation("RiskMethodologyVersionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  assessments RiskAssessment[] @relation("RiskAssessmentMethodologyVersion")

  @@unique([methodologyId, versionNumber])
  @@map("risk_methodology_versions")
}

// ---------------------------------------------------------------------------
// Risk Management — Assessment (data-model.md §9) — T120/US4
// ---------------------------------------------------------------------------

/// **Append-only** (FR-064/FR-065): no update path exists — a reassessment
/// always inserts a new row (`CreateAssessmentUseCase`), links
/// `previousAssessmentId` to the risk's prior current assessment, and
/// repoints `Risk.currentAssessmentId`, all in one transaction. Enforced in
/// the application layer only (no trigger/privilege revocation) — see
/// `20260905150100_risk_assessment_methodology_baseline`'s header for why:
/// unlike `audit_event`/`RiskMethodologyVersion`, `risk_assessments` is
/// written by the SAME restricted-role transaction that also writes to
/// `risks` in the identical statement batch, so a privilege-based
/// enforcement would have to distinguish "the assessment INSERT this
/// transaction is allowed to make" from "an UPDATE/DELETE nothing should
/// ever make" using the SAME role and connection — a trigger is the only
/// mechanism that could do this cleanly, and this migration documents,
/// rather than silently accepts, the choice not to add one yet.
///
/// `createdAt`/`updatedAt` are deliberately absent — see
/// `RiskMethodology`'s header comment above for the general rule this
/// follows. `assessedOn` (`date`, business-supplied, "may not be in the
/// future" per the request contract) is NOT quite `effectiveFrom`'s
/// equivalent (it is a business date, not necessarily the literal insertion
/// instant), but the ordering index below (`riskId, assessedOn DESC`) is the
/// access path data-model.md §9 actually specifies, and UUIDv7's own
/// time-ordering (`id`) already gives an exact, literal insertion-order
/// tiebreaker with no extra column needed — see
/// `risk-assessment.repository.ts`'s `listByRisk` for where that tiebreak is
/// applied.
model RiskAssessment {
  id                   String    @id @default(uuid(7)) @db.Uuid
  riskId               String    @map("risk_id") @db.Uuid
  methodologyVersionId String    @map("methodology_version_id") @db.Uuid
  assessedByUserId     String    @map("assessed_by_user_id") @db.Uuid
  assessedOn           DateTime  @map("assessed_on") @db.Date
  inherentProbability  Int       @map("inherent_probability")
  inherentImpact       Int       @map("inherent_impact")
  inherentScore        Int       @map("inherent_score")
  inherentLevel        RiskLevel @map("inherent_level")
  residualProbability  Int       @map("residual_probability")
  residualImpact       Int       @map("residual_impact")
  residualScore        Int       @map("residual_score")
  residualLevel        RiskLevel @map("residual_level")
  /// Snapshot of control ids considered at assessment time — deliberately
  /// NOT an FK set (data-model.md §9: "it must record what was true at
  /// assessment time even if a control link is later removed"). `Control`
  /// does not exist yet (US5); this column holds plain uuids regardless.
  controlsConsidered   String[]  @default([]) @map("controls_considered") @db.Uuid
  rationale            String?
  previousAssessmentId String?   @map("previous_assessment_id") @db.Uuid

  risk               Risk                   @relation("RiskAssessmentRisk", fields: [riskId], references: [id], onDelete: Restrict)
  methodologyVersion RiskMethodologyVersion @relation("RiskAssessmentMethodologyVersion", fields: [methodologyVersionId], references: [id], onDelete: Restrict)
  assessedByUser     User                   @relation("RiskAssessmentAssessedBy", fields: [assessedByUserId], references: [id], onDelete: Restrict)
  previousAssessment RiskAssessment?        @relation("RiskAssessmentChain", fields: [previousAssessmentId], references: [id], onDelete: Restrict)
  supersededBy       RiskAssessment[]       @relation("RiskAssessmentChain")
  currentForRisks    Risk[]                 @relation("RiskCurrentAssessment")

  // CHECK constraints (data-model.md §9: "not null, CHECK within scale
  // bounds") are added by hand-written SQL — see the migration's header for
  // exactly what they can and cannot express (a static `>= 1` floor; true
  // scale-membership is a per-methodology-version JSONB lookup, which a
  // single-table CHECK cannot perform).
  @@index([riskId, assessedOn(sort: Desc)])
  @@map("risk_assessments")
}

// ---------------------------------------------------------------------------
// Risk Management — Treatment, Actions and Controls (data-model.md §10) —
// T137/T138/US5
// ---------------------------------------------------------------------------

/// **Append-only** (FR-073): "a new decision stamps `supersededAt` on the
/// previous one rather than overwriting it". Unlike `RiskMethodologyVersion`
/// (never updated at all, enforced by a blanket `REVOKE UPDATE`) this table
/// has exactly ONE legitimate mutation — stamping `superseded_at`/
/// `superseded_by_id` on the row a new decision replaces — so a blanket
/// privilege revocation would break FR-073's own mechanism. See the
/// migration's own header
/// (`20260905160100_risk_treatment_and_relationships_baseline`) for the full
/// reasoning and the `BEFORE UPDATE OR DELETE` trigger that enforces
/// "exactly that one mutation, and nothing else" at the database level —
/// the interpretive decision this task's instructions asked to be made and
/// justified explicitly, in the spirit of (but not identical to)
/// `RiskMethodologyVersion`'s own precedent.
///
/// `createdAt`/`updatedAt` are deliberately absent — same reasoning as
/// `RiskAssessment`'s own header comment: `decidedAt` is already the
/// semantic instant, and a mutable `updatedAt` would contradict the
/// append-only guarantee this table enforces at the database level.
model RiskTreatmentDecision {
  id              String            @id @default(uuid(7)) @db.Uuid
  riskId          String            @map("risk_id") @db.Uuid
  strategy        TreatmentStrategy
  description     String
  deadline        DateTime?         @db.Date
  decidedByUserId String            @map("decided_by_user_id") @db.Uuid
  decidedAt       DateTime          @map("decided_at") @db.Timestamptz(6)
  /// FR-073 — set on the PREVIOUS decision at the moment it is superseded.
  supersededAt    DateTime?         @map("superseded_at") @db.Timestamptz(6)
  /// Points FORWARD to the decision that superseded this one (data-model.md
  /// §10: "supersededById uuid FK -> self, restrict, nullable").
  supersededById  String?           @map("superseded_by_id") @db.Uuid

  risk          Risk                    @relation("RiskTreatmentDecisionRisk", fields: [riskId], references: [id], onDelete: Restrict)
  decidedByUser User                    @relation("RiskTreatmentDecisionDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)
  supersededBy  RiskTreatmentDecision?  @relation("RiskTreatmentDecisionChain", fields: [supersededById], references: [id], onDelete: Restrict)
  supersedes    RiskTreatmentDecision[] @relation("RiskTreatmentDecisionChain")

  treatmentActions RiskTreatmentAction[] @relation("RiskTreatmentActionDecision")
  currentForRisks  Risk[]                @relation("RiskCurrentTreatment")

  @@index([riskId, decidedAt(sort: Desc)])
  @@map("risk_treatment_decisions")
}

/// Risk-owned in this release, shaped for a future shared Action Plans
/// module (FR-074c): the only risk-specific column is `riskId`. Genuinely
/// mutable (title/description/responsible/dueOn/status all change in
/// place) and independently meaningful — the `Risk`/`RiskMethodology`
/// precedent applies (not `RiskAssessment`'s append-only one), and
/// `createdAt` is additionally required verbatim by
/// `contracts/risks.openapi.yaml`'s `RiskTreatmentAction.createdAt`.
/// 007-implementation-remediation, Frente A, D-1/D-6 (research.md) — the
/// Action convergence. This model is now a pure, explicit link row between
/// `Risk` and the shared `Action` (`grc/action`), per CLAUDE.md §19.3's
/// "tabela de ligação explícita e nomeada" — NOT the authority for any
/// work-item field any more. `Action` (`grc/action`) owns title,
/// description, responsibleUserId, dueOn, status, completion and reopening
/// for every risk treatment action, migrated by
/// `20260911000000_action_convergence_risk_treatment_actions` (APPLIED for
/// real against `pharos_grc_test`, 2026-09-11 — verified schema below
/// matches the live database).
///
/// Every existing `id` is preserved (Constitution Principle XV):
/// `audit_event.entity_type = 'RISK_TREATMENT_ACTION'` rows still point at
/// these ids and still resolve.
model RiskTreatmentAction {
  id                  String   @id @default(uuid(7)) @db.Uuid
  riskId              String   @map("risk_id") @db.Uuid
  treatmentDecisionId String?  @map("treatment_decision_id") @db.Uuid
  /// The shared `Action` this link row points at. NOT NULL/UNIQUE as of the
  /// convergence migration — every `RiskTreatmentAction` now has exactly
  /// one `Action`, and every `Action` at most one link row back (an
  /// `Action` created directly through `POST /actions` with
  /// `originType: RISK_TREATMENT` has NO link row — data-model.md D-2).
  actionId            String   @unique @map("action_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  risk              Risk                   @relation("RiskTreatmentActionRisk", fields: [riskId], references: [id], onDelete: Restrict)
  treatmentDecision RiskTreatmentDecision? @relation("RiskTreatmentActionDecision", fields: [treatmentDecisionId], references: [id], onDelete: Restrict)
  action            Action                 @relation("RiskTreatmentActionAction", fields: [actionId], references: [id], onDelete: Restrict)

  // Replaces the three indexes the migration drops
  // (`(riskId, status)`, `(responsibleUserId, dueOn)`, `(dueOn, status)`) —
  // all referenced at least one of the six columns this model no longer
  // has. Every consumer of those now reads `actions` directly, scoped by
  // `originType = RISK_TREATMENT` / `originId = riskId` (research.md D-7).
  @@index([riskId])
  @@map("risk_treatment_actions")
}

// ---------------------------------------------------------------------------
// Controls Management (003-controls-management, data-model.md §1-§2, §5)
//
// This phase PROMOTES the minimal registry below in place (D-1): `Control`
// is the same table `RiskControlLink.controlId` already references, not a
// second concept. Every column added here is nullable or defaulted, no
// existing column changes type/name/nullability, and `RiskControlLink`
// itself is untouched — see data-model.md §6 for what deliberately does
// NOT change (the risk<->control relationship stays owned by Risk).
// ---------------------------------------------------------------------------

/// D-6 — four lifecycle states. `RETIRED` is terminal and reachable from
/// all three others, including `DRAFT` (research.md D-6's own correction:
/// without `DRAFT -> RETIRED`, a `DRAFT` control that never receives an
/// owner could neither activate (FR-005) nor be deleted (FR-006/no hard
/// delete) and would be trapped forever).
enum ControlStatus {
  DRAFT
  ACTIVE
  SUSPENDED
  RETIRED
}

/// FR-001 — executed by a person, or by a system.
enum ControlNature {
  MANUAL
  AUTOMATED
}

/// FR-001 — when the control acts relative to the event. Named `type` at
/// the API/domain level (contracts/controls.openapi.yaml); the Prisma
/// field is `type`, mapped to the `control_type` column (data-model.md §1)
/// to avoid colliding with PostgreSQL's reserved-adjacent `type` in a
/// context where the enum type itself is also named similarly.
enum ControlType {
  PREVENTIVE
  DETECTIVE
  CORRECTIVE
}

/// D-7 — closed vocabulary for expected verification cadence. Absence
/// (nullable `controls.frequency`) means the control has no vencible
/// effectiveness (FR-015) — deliberately not a member of this enum, which
/// only enumerates DECLARED frequencies.
enum ControlFrequency {
  CONTINUOUS
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
}

/// FR-009 — the result an assessor records when verifying a control. Never
/// includes `NOT_ASSESSED`/`EXPIRED` — those are `ControlEffectiveness`
/// values (data-model.md §3), computed by `ControlEffectivenessService`
/// and never stored (D-2); this enum is only what an assessor may legally
/// WRITE.
enum ControlAssessmentResult {
  EFFECTIVE
  PARTIALLY_EFFECTIVE
  INEFFECTIVE
}

/// Promoted in place from the Fase 1 minimal registry (data-model.md §1,
/// ADR-016, ADR-017: Control is a business-module domain, not a GRC-kernel
/// entity, and does not belong to any framework). `code`/`name`/
/// `description`/`orgUnitId`/`isActive`/`createdAt`/`updatedAt` are
/// UNCHANGED from the Fase 1 shape — `modules/risk` keeps reading
/// `isActive` (now via `ControlDirectoryPort`, ADR-020) with identical
/// semantics.
///
/// `isActive`/`status` coexist deliberately (data-model.md §1): `status` is
/// lifecycle truth, `isActive` is kept in sync by the SINGLE write point
/// `isActiveForControlStatus` (`modules/controls/domain/control.entity.ts`)
/// documents — `false` only for `RETIRED`, `true` otherwise. A control
/// created before this fase has every new column `NULL`/`DRAFT`/default
/// and renders as an incomplete-but-valid control (FR-003), never an
/// error.
model Control {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  orgUnitId   String?  @map("org_unit_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Required only to enter `ACTIVE` (FR-005) — nullable on the column so a
  /// `DRAFT` control may exist before ownership is decided.
  ownerUserId String?           @map("owner_user_id") @db.Uuid
  nature      ControlNature?
  type        ControlType?      @map("control_type")
  frequency   ControlFrequency?
  status      ControlStatus     @default(DRAFT)

  /// Stamped by the transition into `RETIRED`; never any other way.
  retiredAt        DateTime? @map("retired_at") @db.Timestamptz(6)
  retiredByUserId  String?   @map("retired_by_user_id") @db.Uuid
  retirementReason String?   @map("retirement_reason")

  /// Optimistic lock, same mechanism as `Risk.version` (data-model.md §1).
  version Int @default(1)

  orgUnit       OrganizationalUnit? @relation("ControlOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  owner         User?               @relation("ControlOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  retiredByUser User?               @relation("ControlRetiredBy", fields: [retiredByUserId], references: [id], onDelete: Restrict)

  riskLinks            RiskControlLink[]
  assessments          ControlAssessment[]
  processLinks         ControlProcessLink[]
  assetLinks           ControlAssetLink[]
  lifecycleTransitions ControlLifecycleTransition[]
  /// 004-compliance-management (ADR-020 part 2) — the requirement side of
  /// the mapping owns and names this relation; `Control` carries only the
  /// back-reference Prisma requires for the FK, exactly like `riskLinks`
  /// above.
  requirementLinks     RequirementControlLink[]
  /// 005-audit-findings — Control is a valid audit-engagement scope target
  /// (AuditScopeControl, data-model.md §4) AND a valid Finding target
  /// (FindingControlLink, data-model.md §5); `Control` carries only the
  /// back-references Prisma requires for each FK, the same convention as
  /// `riskLinks`/`requirementLinks` above.
  auditScopeLinks      AuditScopeControl[]
  findingLinks         FindingControlLink[]

  @@index([orgUnitId, status])
  @@index([ownerUserId])
  @@map("controls")
}

/// T020/003-controls-management, User Story 1 — the append-only lifecycle
/// history the contract's `getControlLifecycle`/`transitionControl`
/// operations reference as `ControlLifecycleTransition`, but that
/// `data-model.md` never defined a table for (a genuine gap found during
/// implementation — an audit event alone does not satisfy a typed history
/// endpoint). Same shape and rationale as `RiskLifecycleTransition`, minus
/// `approvalId`: Controls' lifecycle has no approval-gated transition
/// (D-6's own "Descartado explicitamente: um estado PENDING_APPROVAL") —
/// every transition is either applied directly or refused, never left
/// pending a decision.
///
/// Append-only by privilege revocation (the `RiskMethodologyVersion`/
/// `risk_lifecycle_transitions` precedent, not a trigger): no application
/// code path ever needs to UPDATE a past transition row after insert — the
/// NEXT transition is simply a new row (see the migration for the full
/// reasoning, transcribed from `risk_lifecycle_transitions`'s own).
model ControlLifecycleTransition {
  id                String        @id @default(uuid(7)) @db.Uuid
  controlId         String        @map("control_id") @db.Uuid
  fromStatus        ControlStatus @map("from_status")
  toStatus          ControlStatus @map("to_status")
  performedByUserId String        @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime      @map("performed_at") @db.Timestamptz(6)
  justification     String?

  control         Control @relation(fields: [controlId], references: [id], onDelete: Restrict)
  performedByUser User    @relation("ControlLifecycleTransitionPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)

  @@index([controlId, performedAt(sort: Desc)])
  @@map("control_lifecycle_transitions")
}

/// The verification of a control's effectiveness (data-model.md §2,
/// FR-009-FR-011). Deliberately **immutable** and, unlike almost every
/// other mutable entity table in this schema, has NO `updatedAt` — a new
/// assessment succeeds the previous one; nothing about a recorded
/// assessment is ever revised in place (FR-010).
///
/// `approvalId` is the attestation cycle (data-model.md §4) — reuses the
/// existing generic `Approval` table (`ApprovableEntityType.CONTROL_ASSESSMENT`)
/// rather than a bespoke workflow (research.md D-3, CLAUDE.md §19.4). Null
/// while no attestation has been requested yet. `attestedAt`/
/// `attestedByUserId` are filled ONLY when the attestation is APPROVED —
/// never on a rejection (data-model.md §3: "verificação não atestada não
/// conta" covers never-requested, pending AND rejected alike).
model ControlAssessment {
  id               String                  @id @default(uuid(7)) @db.Uuid
  controlId        String                  @map("control_id") @db.Uuid
  assessedOn       DateTime                @map("assessed_on") @db.Date
  assessorUserId   String                  @map("assessor_user_id") @db.Uuid
  result           ControlAssessmentResult
  conclusion       String
  approvalId       String?                 @map("approval_id") @db.Uuid
  attestedAt       DateTime?               @map("attested_at") @db.Timestamptz(6)
  attestedByUserId String?                 @map("attested_by_user_id") @db.Uuid
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)

  /// 007-implementation-remediation, D-11/T009 — desnormalizado a partir de
  /// `Control.orgUnitId`, nunca escrito diretamente por caso de uso. Existe
  /// porque a autorização decidia visibilidade desta linha através de um
  /// JOIN até `controls.org_unit_id` — exatamente o que a regra já
  /// ratificada em AGENTS.md proíbe ("carregar o escopo organizacional em
  /// toda tabela escopada, mesmo quando derivável por relação; autorização
  /// nunca deve depender de um JOIN"). MESMA nulidade de `Control.orgUnitId`
  /// (um controle pode não ter unidade). O ÚNICO calculador é o par de
  /// gatilhos da migração `20260911010000_control_assessments_org_unit_id`
  /// (princípio §19.7 desta base — "um único calculador"): um `BEFORE
  /// INSERT` em `control_assessments` que sobrescreve incondicionalmente
  /// `NEW.org_unit_id` a partir do controle referenciado (o valor que um
  /// chamador porventura informe é ignorado, nunca confiável), e um `AFTER
  /// UPDATE` em `controls` que propaga a mudança para toda avaliação já
  /// existente quando `org_unit_id` do controle muda. Nenhum caso de uso
  /// desta base escreve este campo — nem precisa: é sempre correto por
  /// construção, mesmo que um controle mude de unidade depois de já ter
  /// avaliações.
  orgUnitId String? @map("org_unit_id") @db.Uuid

  control        Control             @relation(fields: [controlId], references: [id], onDelete: Restrict)
  assessorUser   User                @relation("ControlAssessmentAssessedBy", fields: [assessorUserId], references: [id], onDelete: Restrict)
  approval       Approval?           @relation("ControlAssessmentApproval", fields: [approvalId], references: [id], onDelete: Restrict)
  attestedByUser User?               @relation("ControlAssessmentAttestedBy", fields: [attestedByUserId], references: [id], onDelete: Restrict)
  orgUnit        OrganizationalUnit? @relation("ControlAssessmentOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)

  /// data-model.md §2 — the exact ordering `ControlEffectivenessService`
  /// walks (most recent attested assessment first) and the history view
  /// renders.
  @@index([controlId, assessedOn(sort: Desc), createdAt(sort: Desc)])
  /// D-11 — supports the scope-filtered listing the repository consumer
  /// adds (`isOrgUnitWithinScope`-style predicate directly on this table,
  /// no JOIN required).
  @@index([orgUnitId])
  @@map("control_assessments")
}

/// Explicit, named link from a control to the process it operates on
/// (data-model.md §5, ADR-020 part 1/2). Same shape as `RiskProcessLink`.
/// Withdrawal stamps `unlinkedAt`/`unlinkedByUserId` rather than deleting
/// the row (FR-023).
///
/// **Partial unique** `(controlId, processId) WHERE unlinkedAt IS NULL` —
/// hand-written in the migration, same documented drift pattern as
/// `risk_control_links_risk_id_control_id_active_key`.
model ControlProcessLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  controlId        String    @map("control_id") @db.Uuid
  processId        String    @map("process_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  control        Control @relation(fields: [controlId], references: [id], onDelete: Restrict)
  process        Process @relation(fields: [processId], references: [id], onDelete: Restrict)
  linkedByUser   User    @relation("ControlProcessLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?   @relation("ControlProcessLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([controlId])
  @@map("control_process_links")
}

/// Same shape and rationale as `ControlProcessLink` above, against `Asset`
/// instead of `Process` (data-model.md §5).
model ControlAssetLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  controlId        String    @map("control_id") @db.Uuid
  assetId          String    @map("asset_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  control        Control @relation(fields: [controlId], references: [id], onDelete: Restrict)
  asset          Asset   @relation(fields: [assetId], references: [id], onDelete: Restrict)
  linkedByUser   User    @relation("ControlAssetLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?   @relation("ControlAssetLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([controlId])
  @@map("control_asset_links")
}

/// A minimal process registry (data-model.md §10) — same shape and
/// rationale as `Control` above; no Process Management module exists in
/// this release (spec Out of Scope).
model Process {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  orgUnitId   String?  @map("org_unit_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit       OrganizationalUnit?   @relation("ProcessOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  riskLinks     RiskProcessLink[]
