/// A minimal asset registry (data-model.md §10) — same shape and rationale
/// as `Control` above; no Asset Management module exists in this release
/// (spec Out of Scope).
model Asset {
  id          String   @id @default(uuid(7)) @db.Uuid
  code        String   @unique
  name        String
  description String?
  orgUnitId   String?  @map("org_unit_id") @db.Uuid
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit       OrganizationalUnit? @relation("AssetOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  riskLinks     RiskAssetLink[]
  controlLinks  ControlAssetLink[]
  // 008-incidents-problems, foundation (data-model.md §2).
  incidentLinks IncidentAssetLink[]

  @@map("assets")
}

/// An explicitly modelled risk-to-control relationship carrying its own
/// facts (FR-077, ADR-008) — NOT a generic polymorphic link table
/// (CLAUDE.md §10). Withdrawal stamps `unlinkedAt`/`unlinkedByUserId`
/// rather than deleting the row, so a removal remains visible in history
/// (FR-076, FR-102).
///
/// **Partial unique** `(riskId, controlId) WHERE unlinkedAt IS NULL`
/// (data-model.md §10) is hand-written SQL — see the migration header for
/// why Prisma's schema language cannot express it (same documented drift
/// pattern as `risk_methodologies_one_active_idx`).
model RiskControlLink {
  id               String    @id @default(uuid(7)) @db.Uuid
