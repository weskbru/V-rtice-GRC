  risk           Risk    @relation("RiskControlLinkRisk", fields: [riskId], references: [id], onDelete: Restrict)
  control        Control @relation(fields: [controlId], references: [id], onDelete: Restrict)
  linkedByUser   User    @relation("RiskControlLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?   @relation("RiskControlLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([riskId])
  @@map("risk_control_links")
}

/// Same shape and rationale as `RiskControlLink` above, against `Process`
/// instead of `Control` (data-model.md §10: "Same shape as
