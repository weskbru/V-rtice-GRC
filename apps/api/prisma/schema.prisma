// data-model.md §5 requires an `AuditEntityType` enum but does not enumerate
// its values anywhere in the spec (unlike `AuditOutcome`, which is spelled
// out). This release only implements Core entities (Phase 2); business
// entities audited by later modules (Risk, RiskAssessment, ...) are added by
// an additive `ALTER TYPE ... ADD VALUE` migration when those modules land —
// consistent with ADR-008's acceptance that closed platform enums grow by
// reviewed migration.
//
// `RISK` was added by migration `20260905140000_audit_entity_type_add_risk`
// (US2, T083) — see that migration's own header for why `ALTER TYPE ... ADD
// VALUE` is safe here even though PostgreSQL forbids USING a value added
// earlier in the SAME transaction: this migration only adds the label, it
// never writes a row with it, so the restriction never applies.
//
// `RISK_ASSESSMENT`/`RISK_METHODOLOGY_VERSION` were added by migration
// `20260905150000_audit_entity_type_add_risk_assessment_methodology` (US4,
// T120/T124/T126), same mechanism, same safety argument: that migration adds
// only the two labels and writes no row using either in the same
// transaction. `RiskCategory`/`RiskType`/`RiskOrigin` administration is still
// not audited (no write path exists for them yet beyond the idempotent,
// unaudited seed) — their own value is added the same way whenever that
// write path is implemented.
//
// `RISK_TREATMENT_DECISION`/`RISK_TREATMENT_ACTION`/`RISK_CONTROL_LINK`/
// `RISK_PROCESS_LINK`/`RISK_ASSET_LINK` were added by migration
// `20260905160000_audit_entity_type_add_risk_treatment` (US5, T139/T140/
// T142), same mechanism and safety argument as the two additions above:
// that migration adds only the five labels and writes no row using any of
// them in the same transaction. Five distinct values, not one generic
// `RISK_RELATIONSHIP` — CLAUDE.md §10/ADR-008 model each relationship
// explicitly, and an audit trail that cannot tell a control link from a
// process link apart would quietly undo that at the one place (the audit
// trail) where the distinction matters most.
enum AuditEntityType {
  USER
  LOCAL_CREDENTIAL
  EXTERNAL_IDENTITY
  SESSION
  PERMISSION
  ROLE
  ROLE_PERMISSION
  USER_ROLE
  ORGANIZATIONAL_UNIT
  ORG_SCOPE_GRANT
  RISK
  RISK_ASSESSMENT
  RISK_METHODOLOGY_VERSION
  RISK_TREATMENT_DECISION
  RISK_TREATMENT_ACTION
  RISK_CONTROL_LINK
  RISK_PROCESS_LINK
  RISK_ASSET_LINK
  // T153/US6 — added by `20260905170000_audit_entity_type_add_risk_lifecycle`
  // (ADR-008: "closed platform enums grow by reviewed migration"). Two
  // distinct values, not one generic `RISK_LIFECYCLE` — the transition log
  // and the approval decision are different business facts (a transition is
  // an applied state change; an approval is a request/decision pair that may
  // never result in a transition at all, e.g. REJECTED), and the audit trail
  // must be able to tell them apart for the same reason the three risk
  // relationship link types above are not one generic value.
  RISK_LIFECYCLE_TRANSITION
  APPROVAL
  // T187/US9 — added by `20260905180000_audit_entity_type_add_collaboration`
  // (ADR-008: "closed platform enums grow by reviewed migration"). Two
  // distinct values, not one generic "collaboration" value — a comment and
  // an attachment are different business facts with different field
  // allow-lists (`core/comments/domain/comments-audit-allowlist.ts`,
  // `core/files/domain/files-audit-allowlist.ts`), the same reasoning that
  // gave every other cross-cutting capability's entities their own value
  // above. `NOTIFICATION` is deliberately absent: FR-100 requires auditing
  // the addition/removal of comments and attachments, not notifications —
  // a notification's own lifecycle (created, read) is not a business action
  // this platform's audit trail needs to record.
  ATTACHMENT
  COMMENT
  // T206a — THROWAWAY PROBE (SC-011 verification). Registered by
  // `modules/_extensibility_probe/`, removed together with the module.
  // Enum values cannot be dropped from a closed PostgreSQL enum without a
  // full type recreation (ADR-008 growth is one-directional); this value is
  // left in place permanently after the probe module itself is deleted —
  // see `docs/deferred-findings.md` for the record of that consequence.
  PROBE_RECORD
  // T010/002-shared-grc-foundation — added by
  // `20260907090000_audit_entity_type_add_grc_foundation` (ADR-008: "closed
  // platform enums grow by reviewed migration"). Four distinct values, not
  // one generic "grc" value — same reasoning as `ATTACHMENT`/`COMMENT`
  // above: each is a different business fact with its own audit field
  // allow-list (`grc/shared/domain/grc-audit-allowlist.ts`), and
  // `EVIDENCE_LINK` is audited separately from `EVIDENCE` the same way
  // `RISK_CONTROL_LINK` is separate from `RISK`.
  EVIDENCE
  EVIDENCE_LINK
  ACTION
  FINDING
  // T020/003-controls-management, User Story 1 — added by
  // `<migration>_audit_entity_type_add_control` (ADR-008: "closed platform
  // enums grow by reviewed migration"). Two distinct values, not one
  // generic "control" value — the same reasoning already given for
  // `RISK`/`RISK_LIFECYCLE_TRANSITION` above: a control's own
  // descriptive/ownership edit is a different business fact from an
  // applied lifecycle-state change, with its own field allow-list
  // (`modules/controls/domain/control-audit-allowlist.ts`). The other
  // Controls Management workstream (assessments, attestation, process/
  // asset links, operations 7-18) registers its own further values
  // (`CONTROL_ASSESSMENT`, `CONTROL_PROCESS_LINK`, `CONTROL_ASSET_LINK`)
  // separately, by its own reviewed migration — deliberately not added
  // here, out of this task's scope.
  CONTROL
  CONTROL_LIFECYCLE_TRANSITION
  // T036/003-controls-management, User Story 2/3 — added by
  // `20260908090000_audit_entity_type_add_control_assessment_and_links`
  // (ADR-008: "closed platform enums grow by reviewed migration"). Three
  // distinct values, not one generic "control relationship" value — an
  // assessment's own record/attestation is a different business fact from
  // a process link, which is itself different from an asset link, each
  // with its own field allow-list
  // (`modules/controls/control-audit-allowlist.ts`) — the same reasoning
  // `RISK_CONTROL_LINK`/`RISK_PROCESS_LINK`/`RISK_ASSET_LINK` above already
  // apply to the Risk side of an explicit, named relationship (ADR-020
  // part 1).
  CONTROL_ASSESSMENT
  CONTROL_PROCESS_LINK
  CONTROL_ASSET_LINK
  // 004-compliance-management, Fase 1 — added by
  // `20260908100000_audit_entity_type_add_compliance` (ADR-008: "closed
  // platform enums grow by reviewed migration"). Seven distinct values,
  // one per business fact FR-025 names — never one generic "compliance"
  // value, the same reasoning already given for every other cross-cutting
  // group above. `FRAMEWORK_VERSION` covers its own DRAFT->PUBLISHED
  // transition too (research.md D-3): unlike `CONTROL_LIFECYCLE_TRANSITION`,
  // this lifecycle has exactly one edge, firing at most once per version,
  // so it is captured as a field change on this same type rather than a
  // separate lifecycle-transition entity type.
  FRAMEWORK
  FRAMEWORK_VERSION
  REQUIREMENT
  REQUIREMENT_CONTROL_LINK
  REQUIREMENT_CONTROL_MAPPING_MIGRATION
  REQUIREMENT_APPLICABILITY
  REQUIREMENT_COMPLIANCE_STATE
  // 005-audit-findings, T005 — added by
  // `20260908110000_audit_entity_type_add_audit_findings` (ADR-008: "closed
  // platform enums grow by reviewed migration"). Six distinct values, one
  // per business fact this module's contract names (FR-020, data-model.md
  // §8) — never one generic value:
  //
  //   * `AUDIT_ENGAGEMENT` — the engagement's own descriptive fields and
  //     all four lifecycle transitions (start/complete/cancel), captured as
  //     a field change on this same type (research.md D-3's own reasoning
  //     for `FRAMEWORK_VERSION` above: few, linear, at-most-once edges).
  //   * `AUDIT_SCOPE_FRAMEWORK_VERSION` / `AUDIT_SCOPE_REQUIREMENT` /
  //     `AUDIT_SCOPE_CONTROL` — one value per scope-link kind (data-model.md
  //     §2-§4), the same reasoning `RISK_CONTROL_LINK`/`RISK_PROCESS_LINK`/
  //     `RISK_ASSET_LINK` already established for three distinct link
  //     tables sharing a similar shape.
  //   * `FINDING_CONTROL_LINK` / `FINDING_RISK_LINK` — the two `Finding`
  //     relationships Phase 1 deferred (data-model.md §5-§6, ADR-020 parts
  //     1/2), owned by `grc/finding`, not by this module — grouped in the
  //     same reviewed migration because they are unrelated-but-co-shipped
  //     values, the same precedent `20260908090000_audit_entity_type_add_
  //     control_assessment_and_links` already set.
  AUDIT_ENGAGEMENT
  AUDIT_SCOPE_FRAMEWORK_VERSION
  AUDIT_SCOPE_REQUIREMENT
  AUDIT_SCOPE_CONTROL
  FINDING_CONTROL_LINK
  FINDING_RISK_LINK
  // 006-assets-processes, T001 — added by
  // `20260908120000_audit_entity_type_add_asset_process` (ADR-008: "closed
  // platform enums grow by reviewed migration"). Two distinct values, not
  // one generic "registry" value — the same reasoning already given for
  // every other cross-cutting group above: `Asset`'s own descriptive edit
  // and lifecycle transition is a different business fact from `Process`'s,
  // each with its own field allow-list
  // (`modules/assets/domain/asset-audit-allowlist.ts`,
  // `modules/processes/domain/process-audit-allowlist.ts`). The four values
  // covering the Risk/Control relationship to Asset/Process already exist
  // above (`RISK_ASSET_LINK`, `RISK_PROCESS_LINK`, `CONTROL_ASSET_LINK`,
  // `CONTROL_PROCESS_LINK`); what was missing was a type for the RECORD
  // itself, because until this fase no operation ever created or altered
  // one (research.md D-8, data-model.md §1).
  ASSET
  PROCESS
  // 008-incidents-problems, foundation — added by
  // `20260911020000_incidents_problems_foundation_baseline` (ADR-008:
  // "closed platform enums grow by reviewed migration"). Seven distinct
  // values, one per business fact this module's data model names
  // (data-model.md §3), never one generic value: `INCIDENT`/`PROBLEM` are
  // each domain's own descriptive fields and lifecycle transitions
  // (research.md D-4/D-5's own reasoning: few, named transitions, captured
  // as a field change on this same type — the same shape
  // `FRAMEWORK_VERSION`/`AUDIT_ENGAGEMENT` above already established).
  // `INCIDENT_RISK_LINK`/`INCIDENT_ASSET_LINK`/`INCIDENT_PROCESS_LINK`/
  // `PROBLEM_RISK_LINK` are four of the five link tables (data-model.md §2),
  // one per pair — the same reasoning `RISK_ASSET_LINK`/`RISK_PROCESS_LINK`/
  // `RISK_ASSET_LINK` already established for distinct link tables sharing
  // a similar shape. `PROBLEM_INCIDENT_LINK` is the fifth — the N:M link
  // decided by the coordinator (spec.md "Decisões do coordenador";
  // research.md D-13 to D-15), owned by Problems (data-model.md §6).
  INCIDENT
  PROBLEM
  INCIDENT_RISK_LINK
  INCIDENT_ASSET_LINK
  INCIDENT_PROCESS_LINK
  PROBLEM_RISK_LINK
  PROBLEM_INCIDENT_LINK
  // 009-indicators-reports, Fase 1 (T003) — added by
  // `20260911040000_indicators_reports_foundation_baseline` (ADR-008:
  // "closed platform enums grow by reviewed migration"). Three distinct
  // values, one per business fact this module's data model names
  // (data-model.md §5): `INDICATOR` covers `IndicatorDefinition`'s own
  // descriptive/threshold edits (creation, later edits) — the same shape
  // `FRAMEWORK_VERSION`/`AUDIT_ENGAGEMENT` above already established for a
  // record with few, linear field changes rather than a lifecycle-
  // transition entity of its own. `INDICATOR_MEASUREMENT` is separate
  // because it audits a different business fact — an append-only
  // measurement's creation, never an edit (the table has none) — with its
  // own field allow-list. `REPORT` covers `ReportDefinition`'s own
  // descriptive edits. `ActionOriginType += INDICATOR` is NOT part of this
  // migration (research.md D-5, CLAUDE.md §19.10) — deferred to Fase 6
  // (US4), paired atomically with `IndicatorActionOriginAccessor`, the same
  // discipline `INCIDENT`/`PROBLEM` already applied to `ActionOriginType`.
  INDICATOR
  INDICATOR_MEASUREMENT
  REPORT
}

// ---------------------------------------------------------------------------
// Risk Management — closed-set enums (data-model.md §8, ADR-008)
// ---------------------------------------------------------------------------

enum RiskStatus {
  DRAFT
  IDENTIFIED
  ASSESSED
  UNDER_TREATMENT
  UNDER_REVIEW
  ACCEPTED
  CLOSED
  ARCHIVED
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

// data-model.md §10 (US5) — FR-071.
enum TreatmentStrategy {
  MITIGATE
  AVOID
  TRANSFER
  ACCEPT
}

// `TreatmentActionStatus` (FR-074, "OPEN | IN_PROGRESS | COMPLETED |
// CANCELLED", `CANCELLED` terminal per FR-102) was REMOVED by
// 007-implementation-remediation, Frente A, D-1: `Action.status`
// (`ActionStatus`, identical value set) is the sole authority for a risk
// treatment action's status now, and `risk_treatment_actions.status` — the
// only column that ever used this enum — was dropped in the same
// migration (`20260911000000_action_convergence_risk_treatment_actions`),
// which also `DROP TYPE`s the enum itself (safe: dropping a whole type,
// unlike removing one value, is unrestricted, and nothing else referenced
// it).

// data-model.md §11 (US6) — FR-029c: an approval is a pending CONDITION on
// the risk, never a tenth lifecycle state. `PENDING` is the only status a
// created row ever starts in (schema default); `APPROVED`/`REJECTED` are
// written exactly once, by `DecideApprovalUseCase`, and are the only
// mutation `approvals`' append-only trigger will ever accept (see the
// migration's own header for the full reasoning).
enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

// data-model.md §11 — `Approval.entityType`. `RISK` is the only participant
// today; the polymorphic (entityType, entityId) shape (ADR-008's documented
// exception, same pattern as comments/attachments) is what lets a future
// module's own approvable entity register itself without a schema change to
// this table.
enum ApprovableEntityType {
  RISK
  /// 003-controls-management, data-model.md §4 — a `ControlAssessment`'s
  /// attestation cycle reuses this existing generic mechanism (research.md
  /// D-3, CLAUDE.md §19.4): "extending sign-off to a new domain is adding
  /// an enum value and a use case, never a workflow engine".
  CONTROL_ASSESSMENT
}

// data-model.md §6 (US9) — `Attachment.entityType`. Same documented
// polymorphic-reference exception as `ApprovableEntityType` above (ADR-008),
// its own closed enum rather than reusing `ApprovableEntityType` or
// `CommentableEntityType` below: a future module may participate in ONE
// capability (e.g. attachable but not approvable) without being forced to
// share a set of values with a capability it does not implement — the same
// reasoning that keeps `RiskControlLink`/`RiskProcessLink`/`RiskAssetLink`
// as three distinct tables rather than one generic relationship.
enum AttachableEntityType {
  RISK
  // 002-shared-grc-foundation, US1 design correction (see `Evidence`'s own
  // section header below for the full account): `Evidence.fileId` as a
  // real FK to `Attachment` could never be populated, because
  // `Attachment` requires its parent (`entityType`/`entityId`) to already
  // exist before it can be created. `EVIDENCE` registered here — via the
  // additive `ALTER TYPE ... ADD VALUE` in
  // `20260907091000_attachable_entity_type_add_evidence` — is what makes
  // "attach a file to an evidence record" possible at all: a file reaches
  // evidence through this same, already-proven attachment mechanism RISK
  // uses (`core/comments/domain/entity-registry.ts`,
  // `EvidenceParentRecordAccessor`), not through a column on `Evidence`
  // that no operation could ever legally set.
  EVIDENCE
  // 008-incidents-problems, foundation (spec.md FR-018, research.md D-2) —
  // registers `Incident`/`Problem` as valid parents for a raw file
  // attachment (outside the formal `Evidence` flow), via the same
  // registry `RISK`/`EVIDENCE` already use — no attachment concept of
  // their own.
  INCIDENT
  PROBLEM
  // T206a — THROWAWAY PROBE (SC-011). See `AuditEntityType.PROBE_RECORD`'s
  // comment above.
  PROBE_RECORD
}

// data-model.md §6 (US9) — `Comment.entityType`. See `AttachableEntityType`
// above for why this is its own enum rather than a shared one; `Risk` is
// registered as both attachable and commentable today, but a future module
// need not be both.
enum CommentableEntityType {
  RISK
  // 008-incidents-problems, foundation (spec.md FR-018, research.md D-2/
  // D-12) — registers `Incident`/`Problem` as valid parents for a comment.
  // `Notification.entityType` reuses this same enum (no
  // `NotificationEntityType` of its own, matching the correction
  // `docs/deferred-findings.md` F-53 already recorded for
  // `platform.openapi.yaml`).
  INCIDENT
  PROBLEM
  // 009-indicators-reports, Fase 1 (T003, spec.md FR-033) — registers
  // `Indicator` as a valid parent for a comment, and as the deep-link
  // target of the threshold-breach notification (US3, `Notification.
  // entityType` reuses this same enum, research.md D-7). `REPORT` is
  // DELIBERATELY absent: no requirement of this phase makes a saved report
  // commentable.
  INDICATOR
  // T206a — THROWAWAY PROBE (SC-011). See `AuditEntityType.PROBE_RECORD`'s
  // comment above.
  PROBE_RECORD
}

enum AuditOutcome {
  SUCCESS
  FAILURE
  DENIED
}

// ---------------------------------------------------------------------------
// Core — Identity and Authentication (data-model.md §1)
// ---------------------------------------------------------------------------

model User {
  id               String     @id @default(uuid(7)) @db.Uuid
  email            String     @unique @db.Citext
  fullName         String     @map("full_name")
  jobTitle         String?    @map("job_title")
  status           UserStatus @default(ACTIVE)
  primaryOrgUnitId String?    @map("primary_org_unit_id") @db.Uuid
  lastLoginAt      DateTime?  @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime   @updatedAt @map("updated_at") @db.Timestamptz(6)

  primaryOrgUnit OrganizationalUnit? @relation("UserPrimaryOrgUnit", fields: [primaryOrgUnitId], references: [id], onDelete: Restrict)

  localCredential                   LocalCredential?
  externalIdentities                ExternalIdentity[]
  sessions                          Session[]
  userRoles                         UserRole[]                @relation("UserRoleAssignee")
  grantedUserRoles                  UserRole[]                @relation("UserRoleGrantedBy")
  orgScopeGrants                    OrgScopeGrant[]           @relation("OrgScopeGrantAssignee")
  grantedScopeGrants                OrgScopeGrant[]           @relation("OrgScopeGrantGrantedBy")
  auditEventsAsActor                AuditEvent[]              @relation("AuditEventActor")
  riskOwnerOf                       Risk[]                    @relation("RiskOwner")
  riskResponsibleOf                 Risk[]                    @relation("RiskResponsible")
  riskAssessmentsMade               RiskAssessment[]          @relation("RiskAssessmentAssessedBy")
  riskMethodologyVersionsPublished  RiskMethodologyVersion[]  @relation("RiskMethodologyVersionCreatedBy")
  riskTreatmentDecisionsDecided     RiskTreatmentDecision[]   @relation("RiskTreatmentDecisionDecidedBy")
  riskControlLinksLinked            RiskControlLink[]         @relation("RiskControlLinkLinkedBy")
  riskControlLinksUnlinked          RiskControlLink[]         @relation("RiskControlLinkUnlinkedBy")
  riskProcessLinksLinked            RiskProcessLink[]         @relation("RiskProcessLinkLinkedBy")
  riskProcessLinksUnlinked          RiskProcessLink[]         @relation("RiskProcessLinkUnlinkedBy")
  riskAssetLinksLinked              RiskAssetLink[]           @relation("RiskAssetLinkLinkedBy")
  riskAssetLinksUnlinked            RiskAssetLink[]           @relation("RiskAssetLinkUnlinkedBy")
  riskLifecycleTransitionsPerformed RiskLifecycleTransition[] @relation("RiskLifecycleTransitionPerformedBy")
