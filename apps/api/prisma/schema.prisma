// ---------------------------------------------------------------------------
// Risk Management — Lifecycle and Approvals (data-model.md §11) — T153/US6
// ---------------------------------------------------------------------------

/// **Append-only** (FR-083): every applied state change is one row, never
/// updated afterward. `id`/`riskId` are set once at creation and never
/// revisited by any code path — unlike `RiskTreatmentDecision` (which has
/// the ONE legitimate `supersede` mutation) or `RiskMethodologyVersion`
/// (never mutated at all, enforced by a blanket privilege revocation), THIS
/// table has no legitimate mutation whatsoever, so it follows
/// `RiskMethodologyVersion`'s precedent exactly: enforced by revoking
/// `UPDATE`/`DELETE` from the restricted application role ONLY (no
/// trigger) — see the migration's own header
/// (`20260905170100_risk_lifecycle_and_approvals_baseline`) for the full
/// justification of why this table, and not `Approval` below, gets the
/// lighter-weight mechanism.
///
/// `createdAt`/`updatedAt` are deliberately absent — `performedAt` is
/// already the semantic instant, same reasoning as `RiskAssessment`'s own
/// header comment.
model RiskLifecycleTransition {
  id                String     @id @default(uuid(7)) @db.Uuid
  riskId            String     @map("risk_id") @db.Uuid
  fromStatus        RiskStatus @map("from_status")
  toStatus          RiskStatus @map("to_status")
  performedByUserId String     @map("performed_by_user_id") @db.Uuid
  performedAt       DateTime   @map("performed_at") @db.Timestamptz(6)
  justification     String?
  /// The `Approval` that authorized this transition, for a gated transition
  /// (`ACCEPTED`/`CLOSED`) — `null` for every direct, non-gated transition.
  approvalId        String?    @map("approval_id") @db.Uuid

  risk            Risk      @relation("RiskLifecycleTransitionRisk", fields: [riskId], references: [id], onDelete: Restrict)
  performedByUser User      @relation("RiskLifecycleTransitionPerformedBy", fields: [performedByUserId], references: [id], onDelete: Restrict)
  approval        Approval? @relation("RiskLifecycleTransitionApproval", fields: [approvalId], references: [id], onDelete: Restrict)

  @@index([riskId, performedAt(sort: Desc)])
  @@map("risk_lifecycle_transitions")
}

/// A request for, and decision on, a transition requiring segregation of
/// duties (FR-029, FR-029a, FR-029b). `(entityType, entityId)` is the
/// deliberate, documented polymorphic exception ADR-008 permits — the SAME
/// pattern as comments/attachments — so a future module's own approvable
/// entity registers against this table without a schema change; `RISK` is
/// the only participant today, and `entityId` deliberately carries NO
/// foreign key of its own for exactly that reason (data-model.md §11's own
/// field list: "not null", never "FK -> Risk").
///
/// **Decision fields written once** (FR-029b): a row is created `PENDING`
/// and is decided AT MOST once — `status`/`decidedByUserId`/`decidedAt`/
/// `justification` all move together, exactly once, from `PENDING` to
/// `APPROVED` or `REJECTED`. Unlike `RiskLifecycleTransition` above (which
/// has NO legitimate mutation and is therefore enforced by a blanket
/// privilege revocation, `RiskMethodologyVersion`'s precedent), this table
/// has EXACTLY ONE legitimate mutation — the decision itself — so it follows
/// `RiskTreatmentDecision`'s precedent instead: a `BEFORE UPDATE OR DELETE`
/// trigger narrowly permitting that one mutation and rejecting every other
/// shape of `UPDATE`, plus a second, independent decision (no double
/// deciding, no "undeciding"). See the migration's own header
/// (`20260905170100_risk_lifecycle_and_approvals_baseline`) for the full
/// reasoning and the trigger body.
///
/// **Check (FR-029a)**: `decided_by_user_id IS NULL OR decided_by_user_id <>
/// requested_by_user_id` — a database backstop to the domain rule
/// (`assertApproverDiffersFromRequester`, `domain/approval.ts`), so
/// segregation of duties holds even if a future code path forgets it.
///
/// **Partial unique** (hand-written SQL, Prisma's schema language has no
/// partial-index syntax — same documented drift pattern as
/// `risk_methodologies.is_active`): one `PENDING` approval per
/// `(entity_type, entity_id)` (data-model.md §11) — the database-level
/// backstop for the `POST /risks/{riskId}/approvals` 409 "already pending"
/// rule, so a race between two simultaneous requests cannot both insert a
/// second pending row.
///
/// `createdAt`/`updatedAt` are deliberately absent — `requestedAt`/
/// `decidedAt` are already the two semantic instants this row ever needs.
model Approval {
  id                  String               @id @default(uuid(7)) @db.Uuid
  entityType          ApprovableEntityType @map("entity_type")
  entityId            String               @map("entity_id") @db.Uuid
  /// The gated transition being requested, e.g. `UNDER_TREATMENT->ACCEPTED`
  /// (data-model.md §11). A single text field, not two `RiskStatus`
  /// columns — deliberately, so `ApprovableEntityType` values other than
  /// `RISK` are not forced to share `Risk`'s own state enum.
  requestedTransition String               @map("requested_transition")
  requestedByUserId   String               @map("requested_by_user_id") @db.Uuid
  requestedAt         DateTime             @map("requested_at") @db.Timestamptz(6)
  status              ApprovalStatus       @default(PENDING)
  decidedByUserId     String?              @map("decided_by_user_id") @db.Uuid
  decidedAt           DateTime?            @map("decided_at") @db.Timestamptz(6)
  justification       String?

  requestedByUser User  @relation("ApprovalRequestedBy", fields: [requestedByUserId], references: [id], onDelete: Restrict)
  decidedByUser   User? @relation("ApprovalDecidedBy", fields: [decidedByUserId], references: [id], onDelete: Restrict)

  lifecycleTransitions RiskLifecycleTransition[] @relation("RiskLifecycleTransitionApproval")
  pendingForRisks      Risk[]                    @relation("RiskPendingApproval")
  // 003-controls-management, data-model.md §4 — `ControlAssessment`'s
  // attestation cycle, same non-unique FK shape as `pendingForRisks` above
  // (an `Approval` row is used by at most one assessment in practice, by
  // convention, not a DB-level uniqueness constraint — identical to how
  // `Risk.pendingApprovalId` is modeled).
  controlAssessments   ControlAssessment[]       @relation("ControlAssessmentApproval")

  // FR-029b/dashboard pending-approvals tile (data-model.md §11's own index
  // choice).
  @@index([status, entityType, entityId])
  @@map("approvals")
}

// ---------------------------------------------------------------------------
// Core — Files, Comments, Notifications (data-model.md §6) — T187/US9
// ---------------------------------------------------------------------------
//
// `Attachment`/`Comment` carry no access rules of their own (FR-098): every
// read/write is authorized against the PARENT record named by
// `(entityType, entityId)`, resolved at the application layer through the
// registry `core/comments/domain/entity-registry.ts` defines — deliberately
// no FK from `entityId` to any specific table, same documented polymorphic
// exception as `Approval` above (ADR-008).
//
// `createdAt` is present on all three models even though data-model.md §6's
// own field tables omit it (unlike the blanket "every table carries
// createdAt/updatedAt" convention D-7 resolved for OTHER tables) — the
// OpenAPI contracts (`Comment`/`Attachment`/`Notification` schemas in
// `contracts/platform.openapi.yaml`) make it a REQUIRED response field for
// all three, which settles the omission unambiguously in the same direction
// D-7 already went. No `updatedAt` on any of the three: each has exactly one
// possible mutation after creation (a soft-delete marker, or `readAt`), so a
// generic "last changed" column would be redundant with that field — the
// same reasoning `Session` (`createdAt` + `lastActivityAt`, no `updatedAt`)
// already established.

/// Evidence attached to a GRC record (FR-096 to FR-100, ADR-010). The
/// storage layer knows nothing about risks: `storageKey` is a generated,
/// content-addressed identifier (`core/files/infrastructure/
/// local-disk-storage-provider.ts`) — NEVER derived from `fileName`, which
/// is retained purely as display metadata and never used to build a path on
/// disk (ADR-010's "attachment name collisions and unsafe names" edge case).
model Attachment {
  id               String               @id @default(uuid(7)) @db.Uuid
  entityType       AttachableEntityType @map("entity_type")
  entityId         String               @map("entity_id") @db.Uuid
  fileName         String               @map("file_name")
  contentType      String               @map("content_type")
  sizeBytes        BigInt               @map("size_bytes")
  checksumSha256   String               @map("checksum_sha256")
  storageKey       String               @map("storage_key")
  uploadedByUserId String               @map("uploaded_by_user_id") @db.Uuid
  createdAt        DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Withdrawal preserves attribution (FR-102) — never a hard delete, and
  /// the underlying stored bytes are never deleted either (see the storage
  /// provider's own header: content-addressed keys may be shared by more
  /// than one `Attachment` row).
  deletedAt        DateTime?            @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId  String?              @map("deleted_by_user_id") @db.Uuid

  uploadedByUser User  @relation("AttachmentUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  deletedByUser  User? @relation("AttachmentDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  // GRC Shared Kernel (ADR-016, 002-shared-grc-foundation) — `Evidence`
  // previously pointed here via a real `fileId` FK (T005/T007); removed by
  // the US1 design correction (see `Evidence`'s own section header
  // comment). A file now reaches evidence the SAME way it reaches a
  // `Risk` — through `entityType: EVIDENCE`/`entityId` on this table, with
  // no reverse Prisma relation declared here, matching how `RISK`
  // attachments are read (`entityType`/`entityId` query, never a relation
  // traversal from the `Risk` side either).

  @@index([entityType, entityId, deletedAt])
  @@map("attachments")
}

/// An attributed note on a GRC record (FR-095, FR-100). `body` is stored raw
/// and rendered as plain text only — never interpreted as markup (XSS
/// defence, `contracts/platform.openapi.yaml`'s own description of this
/// field).
model Comment {
  id              String                @id @default(uuid(7)) @db.Uuid
  entityType      CommentableEntityType @map("entity_type")
  entityId        String                @map("entity_id") @db.Uuid
  body            String
  authorUserId    String                @map("author_user_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Withdrawal preserves attribution (FR-102) — never a hard delete.
  deletedAt       DateTime?             @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId String?               @map("deleted_by_user_id") @db.Uuid

  authorUser    User  @relation("CommentAuthor", fields: [authorUserId], references: [id], onDelete: Restrict)
  deletedByUser User? @relation("CommentDeletedBy", fields: [deletedByUserId], references: [id], onDelete: Restrict)

  @@index([entityType, entityId, deletedAt])
  @@map("comments")
}

/// An in-application message directed to one user (FR-101). `type` is a
/// free-form, dot-namespaced business event identifier (e.g.
/// `risk.approval.requested`) rather than a closed Postgres enum —
/// deliberately the same modeling choice as `audit_event.action`
/// (schema.prisma's own `AuditEvent.action` field, `String`, not an enum):
/// enumerating every present-and-future module's notification-worthy event
/// up front is exactly the kind of premature, closed-set commitment
/// ADR-008 reserves for values the PLATFORM defines, not values every
/// future module keeps contributing to. `contracts/platform.openapi.yaml`'s
/// own `Notification.type` schema agrees: `type: string`, not an enum.
/// `entityType`/`entityId` (the deep-link target) reuse `CommentableEntityType`
/// rather than a third near-identical enum (CLAUDE.md §2: "não criar
/// abstrações prematuras") — every entity type registered as commentable is
/// exactly the set of GRC records a notification could plausibly deep-link
/// to; a future notification target that is not commentable can register a
/// widened type when that need is real, not speculatively now.
model Notification {
  id              String                 @id @default(uuid(7)) @db.Uuid
  recipientUserId String                 @map("recipient_user_id") @db.Uuid
  type            String
  title           String
  body            String?
  entityType      CommentableEntityType? @map("entity_type")
  entityId        String?                @map("entity_id") @db.Uuid
  readAt          DateTime?              @map("read_at") @db.Timestamptz(6)
  createdAt       DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)

  recipientUser User @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, readAt, createdAt(sort: Desc)])
  @@map("notifications")
}

// ---------------------------------------------------------------------------
// GRC Shared Kernel — Evidence, Action, Finding (ADR-016, ADR-018,
// specs/002-shared-grc-foundation/data-model.md §2-§5) — T005
// ---------------------------------------------------------------------------
//
// `Control` deliberately does NOT appear here (ADR-016: a future Controls
// module can be its sole owner; it is referenced by port, ADR-020, never
// possessed by this kernel).
//
// ## Enum count — a spec/reality note, flagged per this task's explicit
// instruction to report what turned out to be wrong rather than silently
// work around it
//
// data-model.md §1 states "Quatro modelos novos e seis enums novos". The
// body of §2-§5 actually specifies ELEVEN: `EvidenceType`, `EvidenceSource`,
// `EvidenceStatus` (§2); `EvidenceSubjectType` (§3); `ActionOriginType`,
// `ActionStatus` (§4); `FindingCategory`, `FindingOrigin`,
// `FindingSeverity`, `FindingPriority`, `FindingStatus` (§5). The per-section
// bodies are the authoritative, field-by-field source; the "seis" in the §1
// summary is stale/miscounted and is not followed here.
//
// ## `Evidence.fileId` — REMOVED. A design correction made during US1
// implementation (T017-T038), not the original T005/T007 shape.
//
// data-model.md §2 originally described `fileId` as "FK real para `File` —
// reutiliza a infraestrutura existente", implemented at T005/T007 as a real
// FK to `Attachment.id` (the closest existing "already stored file" row —
// this codebase has no standalone `File` model; file storage and "this
// file is attached to that record" are the SAME row, `Attachment`,
// `entityType`/`entityId` mandatory).
//
// That combination cannot work, and the reason is structural, not
// incidental: `Attachment` is attached TO a parent, and
// `UploadService`/`getAttachableEntityAccessor(...).resolveViewableParent`
// resolves that parent BEFORE the attachment row is created — it throws if
// the parent does not exist yet. So an attachment can only be created
// AFTER its evidence exists, which means `Evidence.file_id` is necessarily
// NULL at the moment an evidence row is inserted. The CHECK that required
// `file_id IS NOT NULL OR external_url IS NOT NULL OR observation IS NOT
// NULL` therefore, in practice, always forced `external_url` or
// `observation` — `file_id` was a column no `INSERT` could ever legally
// populate at the instant the constraint was evaluated. A column with no
// operation that can correctly populate it is not a narrower model; it is
// a declared-but-never-exercised path (CLAUDE.md §19.10's naming for
// exactly this failure class), the same one this codebase has already
// paid for more than once.
//
// **Correction, applied additively** (migrations
// `20260907091000_attachable_entity_type_add_evidence` and
// `20260907091100_evidence_file_fk_correction`, never editing the already-
// applied `20260907090100_grc_foundation_baseline`):
//
//   1. `fileId`, its FK and any index on it are dropped from `Evidence`.
//   2. `EVIDENCE` is registered in `AttachableEntityType` (see that enum's
//      own comment above) and given an accessor in the entity registry
//      (`core/comments/domain/entity-registry.ts`), exactly the way `RISK`
//      already does it. A file now reaches evidence through the SAME,
//      already-proven attachment mechanism (`POST /attachments` with
//      `entityType: EVIDENCE, entityId: <evidence.id>`) — created strictly
//      AFTER the evidence row exists, which is the only order that was
//      ever going to work.
//   3. The CHECK below is narrowed to `external_url IS NOT NULL OR
//      observation IS NOT NULL` — see this constraint's own comment,
//      immediately below the `Evidence` model, for the deliberate
//      consequence this narrowing accepts and why it is an improvement,
//      not merely a fix.
//
// `specs/002-shared-grc-foundation/data-model.md` §2 and `spec.md` FR-002
// are updated to match, marked plainly as a revision made during
// implementation, with this same reasoning — CLAUDE.md's own rule against
// rewriting history to pretend the original shape was right.
//
// ## `Action.originId` / `EvidenceLink.subjectId` — no FK (R-001)
//
// Deliberate, not an oversight: `grc/**` may not import `modules/**`
// (ADR-016), and a real FK to e.g. `risks.id` would require exactly that
// import. The closed-type registration (`originType`/`subjectType` plus a
// bare `uuid` id, indexed but not FK'd) is the SAME mechanism already
// proven four times in this schema — `Attachment.entityId`,
// `Comment.entityId`, `Approval.entityId`, `Notification.entityId` all
// carry no `@relation`. See research.md R-001 for the full reasoning and
// the accepted consequence (an invalid subject id is caught by the use
// case's own scope/existence check via the resolver port, not by the
// database).
//
// ## Overview-diagram vs. field-table inconsistency — another spec note
//
// data-model.md §1's overview diagram reads "Finding --1:N--> Action FK
// real (ambos em grc/)", implying a real `findingId` FK column on `Action`.
// §4's own field table contradicts this: `Action` has exactly ONE
// origin-reference shape — `originType`/`originId`, the same closed-type
// registration used for `RISK_TREATMENT` — and `FINDING` is listed as one
// of `ActionOriginType`'s values, not as a second, FK'd column. A real
// `findingId` FK alongside `originId` would give `Action` two competing
// origin mechanisms depending on which domain created it, which is exactly
// what R-001/FR-012's "single closed set of origin types" is designed to
// prevent. The field table (§4), R-001 and FR-012 are followed here:
// `Action` reaches a `Finding` only through `originType = FINDING` /
// `originId = <finding.id>`, with no dedicated FK column. The diagram line
// is not implemented as literally stated.
//
// ## Hand-written migration
//
// Same standing rule as every other migration in this file (see the header
// comment and docs/local-environment.md's D-1/D-7): hand-written SQL,
// applied with `prisma migrate deploy`, never generated by `prisma migrate
// dev` against a real database. The CHECK for Invariant E1 and the partial
// unique index for Invariant L1 are exactly the two constructs Prisma's
// schema language cannot express (no `@@check`, no partial `@@unique`) —
// the same documented drift pattern as `risk_methodologies_one_active_idx`
// and the three risk relationship link tables' partial unique indexes.

enum EvidenceType {
  DOCUMENT
  SCREENSHOT
  SYSTEM_LOG
  ATTESTATION
  INSPECTION
  OTHER
}

enum EvidenceSource {
  MANUAL_UPLOAD
  SYSTEM_EXPORT
  THIRD_PARTY
  INSPECTION
}

/// data-model.md §2: deliberately ONLY two members. An earlier draft of
/// this model also included `EXPIRED` while simultaneously stating
/// expiry is derived on read from `validUntil` — the two cannot both be
/// true (either the column accepts `EXPIRED` and something writes it, or
/// it does not). `validUntil` is the sole source of truth; "expired" is a
/// read-time projection (see `Evidence` below and `overdue.service.ts`'s
/// sibling for the same shape applied to `Action`), never a stored status.
enum EvidenceStatus {
  ACTIVE
  ARCHIVED
}

/// data-model.md §3 — the closed set of subject types `EvidenceLink` may
/// point at (R-001, ADR-018). Deliberately NOT extended with `CONTROL`/
/// `REQUIREMENT`/`AUDIT` now: an enum value with no consumer is exactly
/// the speculative abstraction the admission criterion forbids.
enum EvidenceSubjectType {
  RISK
  RISK_TREATMENT_DECISION
  FINDING
  ACTION
  /// 003-controls-management, data-model.md §7/FR-026 — a control's own
  /// execution evidence, via the same closed-type registration every other
  /// subject already uses; no second evidence concept is introduced.
  CONTROL
  /// 008-incidents-problems, foundation (spec.md FR-017, research.md D-2) —
  /// proof of what happened (Incident) or of the root cause and its
  /// analysis (Problem), via the same closed-type registration every other
  /// subject already uses; no second evidence concept is introduced.
  INCIDENT
  PROBLEM
}

/// GRC assertion that substantiates a decision (FR-001-FR-010). NOT the
/// file itself — a file reaches evidence via the generic `Attachment`
/// mechanism (`entityType: EVIDENCE`, `entityId: <this row's id>`), never
/// via a column here. See this section's header comment for why an FK
/// column on this model could never work.
model Evidence {
  id               String         @id @default(uuid(7)) @db.Uuid
  /// `EVD-2026-0001` (R-008) — immutable once assigned.
  code             String         @unique
  orgUnitId        String         @map("org_unit_id") @db.Uuid
  title            String
  description      String?
  type             EvidenceType
  /// Procedência — how the evidence entered the system (FR-010).
  source           EvidenceSource
  ownerUserId      String         @map("owner_user_id") @db.Uuid
  /// The date the evidence itself refers to — deliberately distinct from
  /// `createdAt` (FR-005): a March artifact may be registered in April.
  collectedOn      DateTime       @map("collected_on") @db.Date
  /// Optional expiry. `expired` is NEVER a stored column — computed on
  /// read from this field and `status` (data-model.md §6).
  validUntil       DateTime?      @map("valid_until") @db.Date
  status           EvidenceStatus @default(ACTIVE)
  externalUrl      String?        @map("external_url")
  /// The evidence itself, when there is no external reference (FR-002 edge
  /// case: "not every proof is a document"). When a file backs this
  /// evidence (via `Attachment`, `entityType: EVIDENCE`), invariant E1
  /// below still requires this or `externalUrl` — a one-line account of
  /// what the file shows, e.g. "penetration test report covering the
  /// admin API", is more useful to an auditor than a bare filename, and is
  /// what keeps FR-002's intent (evidence is always human-readable)
  /// enforceable at the database now that there is no `fileId` column for
  /// the CHECK below to also test.
  observation      String?
  /// Archival preserves every historical link (FR-009) — never a hard
  /// delete. Filled together with `archivedByUserId` or not at all
  /// (Invariant E3) — unlike E1/E2, this has no named guard function and
  /// no CHECK constraint; it holds only because
  /// `EvidenceRepositoryPort.archive()` is the sole call site writing
  /// either field, and both parameters are required (F-42). A second call
  /// site writing just one field would have nothing stopping it.
  archivedAt       DateTime?      @map("archived_at") @db.Timestamptz(6)
  archivedByUserId String?        @map("archived_by_user_id") @db.Uuid
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit        OrganizationalUnit @relation("EvidenceOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  ownerUser      User               @relation("EvidenceOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  archivedByUser User?              @relation("EvidenceArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  links          EvidenceLink[]     @relation("EvidenceLinkEvidence")

  // Indexes verbatim per data-model.md §2.
  @@index([orgUnitId, status])
  @@index([validUntil, status])
  @@index([ownerUserId, status])
  @@map("evidence")
}

/// Named association between one `Evidence` and one subject (FR-007,
/// FR-008) — its own entity, not a column, because the link itself has an
/// author, a date, a history and its own audit event.
///
/// **Invariant L1** (partial unique index, hand-written migration): the
/// same `(evidenceId, subjectType, subjectId)` triple may not have two
/// ACTIVE links (`unlinkedAt IS NULL`) at once, though it may have a
/// history of link/unlink cycles.
/// **Invariant L2** (domain-enforced): `unlinkedAt`/`unlinkedByUserId` are
/// filled together or not at all.
model EvidenceLink {
  id               String              @id @default(uuid(7)) @db.Uuid
  evidenceId       String              @map("evidence_id") @db.Uuid
  subjectType      EvidenceSubjectType @map("subject_type")
  /// No FK — see this section's header comment (R-001).
  subjectId        String              @map("subject_id") @db.Uuid
  linkedAt         DateTime            @map("linked_at") @db.Timestamptz(6)
  linkedByUserId   String              @map("linked_by_user_id") @db.Uuid
  /// Unlink preserves the row (FR-008/R-007) — never a hard delete.
  unlinkedAt       DateTime?           @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?             @map("unlinked_by_user_id") @db.Uuid
  /// Why this evidence substantiates this subject.
  note             String?

  evidence       Evidence @relation("EvidenceLinkEvidence", fields: [evidenceId], references: [id], onDelete: Restrict)
  linkedByUser   User     @relation("EvidenceLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?    @relation("EvidenceLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  // Indexes verbatim per data-model.md §3. The partial unique index for
  // Invariant L1 is added by hand-written SQL in the migration — Prisma's
  // schema language has no partial-index syntax.
  @@index([subjectType, subjectId, unlinkedAt])
  @@index([evidenceId, unlinkedAt])
  @@map("evidence_links")
}

/// data-model.md §4 — the closed set of domains that may originate an
/// `Action` (R-001, ADR-018, FR-012). Deliberately NOT extended with
/// `INCIDENT`/`COMPLIANCE_GAP`/`CONTROL_IMPROVEMENT`/`PROBLEM` now: those
/// arrive with their own modules.
enum ActionOriginType {
  RISK_TREATMENT
  FINDING
  /// 003-controls-management, data-model.md §7/FR-027, research.md D-5 —
  /// the origin is the FACT that justifies the remediation action (a
  /// verification that failed), never the generic `CONTROL` entity itself.
  CONTROL_ASSESSMENT
  /// 008-incidents-problems — added in its own migration
  /// (`20260911030000_action_origin_type_add_incidents_problems`),
  /// separate from the foundation migration, paired atomically with
  /// `IncidentActionOriginAccessor`/`ProblemActionOriginAccessor`
  /// (registered in `IncidentsModule`/`ProblemsModule`) — `test/unit/
  /// action-model-convergence-guard.spec.ts`'s 1:1 rule is what proves
  /// the pairing is real, not merely declared (spec.md FR-016).
  INCIDENT
  PROBLEM
  /// 009-indicators-reports, Fase 6 (US4) — added in its own migration
  /// (`20260912000000_action_origin_type_add_indicator`), separate from
  /// the foundation migration (`20260911040000_indicators_reports
  /// _foundation_baseline`, which deliberately left this enum untouched —
  /// see that migration's own header), paired atomically with
  /// `IndicatorActionOriginAccessor` (registered in `IndicatorsModule`) —
  /// `test/unit/action-model-convergence-guard.spec.ts`'s 1:1 rule is what
  /// proves the pairing is real, not merely declared (spec.md FR-020,
  /// research.md D-5). `originId` is the `IndicatorDefinition`'s own id.
  INDICATOR
}

/// data-model.md §4 — deliberately identical in shape to
/// `TreatmentActionStatus` so the R-003 convergence is a 1:1 mapping, not a
/// translation.
enum ActionStatus {
  OPEN
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

/// The one, shared unit of trackable work (FR-011-FR-019). Origin is a
/// closed-type registration (`originType`/`originId`), never a per-domain
/// FK — see this section's header comment on why `Finding` is not an
/// exception.
///
/// **Invariant A1** (domain-enforced): `completedAt` set if and only if
/// `status = COMPLETED`.
/// **Invariant A2** (domain-enforced): reopening requires a non-empty
/// `reopenReason`.
/// **Invariant A3**: `dueOn` in the past is accepted at creation — a
/// database CHECK would forbid exactly the case FR-013/A3 requires to be
/// representable (already-overdue remediation is recorded, not blocked).
model Action {
  id                String           @id @default(uuid(7)) @db.Uuid
  /// `ACT-2026-0001` (R-008).
  code              String           @unique
  orgUnitId         String           @map("org_unit_id") @db.Uuid
  originType        ActionOriginType @map("origin_type")
  /// No FK — see this section's header comment (R-001). A `RISK_TREATMENT`
  /// origin cannot be FK'd without `grc` importing `modules/risk`
  /// (ADR-016); the SAME closed-type mechanism is used uniformly for every
  /// origin, including `FINDING`, so `Action` never has two competing
  /// origin-reference shapes depending on who created it.
  originId          String           @map("origin_id") @db.Uuid
  title             String
  description       String?
  responsibleUserId String           @map("responsible_user_id") @db.Uuid
  dueOn             DateTime         @map("due_on") @db.Date
  status            ActionStatus     @default(OPEN)
  /// Stamped together, on completion (Invariant A1).
  completedAt       DateTime?        @map("completed_at") @db.Timestamptz(6)
  completedByUserId String?          @map("completed_by_user_id") @db.Uuid
  /// Reopening a completed action is its own event (FR-016) — the previous
  /// completion stamp above is left untouched, never overwritten.
  reopenedAt        DateTime?        @map("reopened_at") @db.Timestamptz(6)
  reopenedByUserId  String?          @map("reopened_by_user_id") @db.Uuid
  reopenReason      String?          @map("reopen_reason")
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit             OrganizationalUnit   @relation("ActionOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  responsibleUser     User                 @relation("ActionResponsible", fields: [responsibleUserId], references: [id], onDelete: Restrict)
  completedByUser     User?                @relation("ActionCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  reopenedByUser      User?                @relation("ActionReopenedBy", fields: [reopenedByUserId], references: [id], onDelete: Restrict)
  /// T006/R-003 — the reverse side of `RiskTreatmentAction.actionId` during
  /// the double-write convergence window.
  /// 007-implementation-remediation, Frente A — to-one back-relation
  /// (`action_id` is `@unique` on the link table): `null` for an `Action`
  /// created directly through `POST /actions` with `originType:
  /// RISK_TREATMENT` (no link row); present for one created from the risk
  /// screen.
  riskTreatmentAction RiskTreatmentAction? @relation("RiskTreatmentActionAction")

  // Indexes verbatim per data-model.md §4: "(responsibleUserId, status,
  // dueOn) atende 'minhas ações' e 'atrasadas'".
  @@index([responsibleUserId, status, dueOn])
  @@index([originType, originId])
  @@index([orgUnitId, status])
  @@index([dueOn, status])
  @@map("actions")
}

/// data-model.md §5 — the closed set of ways a `Finding` was surfaced.
/// Deliberately NOT extended with `AUDIT`/`COMPLIANCE_MONITORING`/
/// `SECURITY_ASSESSMENT`/`PRIVACY_ASSESSMENT` now: those arrive with their
/// own modules.
enum FindingOrigin {
  INTERNAL_ASSESSMENT
  CONTROL_TESTING
  MANAGEMENT_REVIEW
}

enum FindingCategory {
  NONCONFORMITY
  CONTROL_DEFICIENCY
  OBSERVATION
  IMPROVEMENT_OPPORTUNITY
}

/// The gravity of what was found — a fact, and never changes with context
/// (R-005). See `FindingPriority` for the distinct, independently-mutable
/// concept of urgency.
enum FindingSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

/// The urgency of treating a finding — a management decision, distinct
/// from `FindingSeverity` and may change without the underlying fact
/// changing (R-005).
enum FindingPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum FindingStatus {
  OPEN
  IN_REMEDIATION
  CLOSED
  ARCHIVED
}

/// A GRC observation (FR-020-FR-027) — never a generic problem record.
/// Substantiated by `Evidence` (via `EvidenceLink`, `subjectType =
/// FINDING`) and remediated by `Action` (via `originType = FINDING`);
/// neither is a Prisma relation on this model — both are resolved through
/// the closed-type registration, exactly like every other subject/origin
/// reference in this file (R-001).
///
/// **Invariant F1** (domain-enforced): closing requires at least one
/// linked, completed `Action` OR a non-empty `closureJustification`.
/// **Invariant F2 — segregation of duties** (domain-enforced, spans
/// `Action`, so not a database CHECK): `closedByUserId` may not be the
/// `responsibleUserId` of any completed `Action` linked to this finding.
/// **Invariant F3** (enforced by omission): completing every linked
/// action never transitions `status` — only the explicit close operation
/// does (FR-024). No trigger, no code path does this implicitly.
/// **Invariant F4** (domain-enforced): only a `CLOSED` finding may be
/// archived.
model Finding {
  id                   String          @id @default(uuid(7)) @db.Uuid
  /// `FND-2026-0001` (R-008).
  code                 String          @unique
  orgUnitId            String          @map("org_unit_id") @db.Uuid
  title                String
  description          String
  recommendation       String?
  category             FindingCategory
  origin               FindingOrigin
  /// Gravity of the fact (R-005) — distinct from `priority` below.
  severity             FindingSeverity
  /// Urgency of treatment (R-005) — distinct from `severity` above.
  priority             FindingPriority
  ownerUserId          String          @map("owner_user_id") @db.Uuid
  identifiedOn         DateTime        @map("identified_on") @db.Date
  status               FindingStatus   @default(OPEN)
  /// Filled together on close (Invariant F1/F2, domain-enforced).
  closedAt             DateTime?       @map("closed_at") @db.Timestamptz(6)
  closedByUserId       String?         @map("closed_by_user_id") @db.Uuid
  closureJustification String?         @map("closure_justification")
  /// Filled together on archive — only reachable from `CLOSED`
  /// (Invariant F4, domain-enforced).
  archivedAt           DateTime?       @map("archived_at") @db.Timestamptz(6)
  archivedByUserId     String?         @map("archived_by_user_id") @db.Uuid
  createdAt            DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  /// 005-audit-findings, T004 (FR-007/FR-008, data-model.md §7) — nullable:
  /// `null` for every achado manual (the Fase 1 path, unchanged); filled
  /// ONLY by `POST /audits/{auditId}/findings`. Extends `Finding`, owned by
  /// `002-shared-grc-foundation`; no other column of this model changes
  /// shape, nulidade or type (SC-007).
  auditEngagementId    String?         @map("audit_engagement_id") @db.Uuid

  orgUnit         OrganizationalUnit   @relation("FindingOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  ownerUser       User                 @relation("FindingOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  closedByUser    User?                @relation("FindingClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  archivedByUser  User?                @relation("FindingArchivedBy", fields: [archivedByUserId], references: [id], onDelete: Restrict)
  auditEngagement AuditEngagement?     @relation(fields: [auditEngagementId], references: [id], onDelete: Restrict)
  controlLinks    FindingControlLink[]
  riskLinks       FindingRiskLink[]

  // Indexes verbatim per data-model.md §5, plus the new §7 index.
  @@index([orgUnitId, status])
  @@index([severity, status])
  @@index([auditEngagementId])
  @@index([ownerUserId, status])
  @@index([status, identifiedOn])
  @@map("findings")
}

/// Atomic per-year counter backing `EVD-`/`ACT-`/`FND-` code allocation
/// (`grc/shared/domain/entity-code.service.ts`, T012), the SAME concurrency
/// idiom `RiskCodeSequence` already establishes (see that model's own
/// comment and `PrismaRiskCodeGenerator`'s header) — one row per
/// `(prefix, year)`, updated by a single `UPSERT ... ON CONFLICT DO UPDATE
/// ... RETURNING`. Infrastructure support for code generation, not a
/// data-model.md §2-§5 entity — the three prefixes share one small table
/// instead of three near-identical ones (`EvidenceCodeSequence`,
/// `ActionCodeSequence`, `FindingCodeSequence`) because the counter's shape
/// does not vary by entity, only its key does.
model GrcCodeSequence {
  prefix    String
  year      Int
  lastValue Int    @default(0) @map("last_value")

  @@id([prefix, year])
  @@map("grc_code_sequences")
}

// ---------------------------------------------------------------------------
// Compliance (004-compliance-management) — closed-set enums (data-model.md §8)
// ---------------------------------------------------------------------------

/// Whether a `Framework` is an external standard (a norm the organization
/// did not author) or an internal policy (FR-001).
enum FrameworkOrigin {
  EXTERNAL_STANDARD
  INTERNAL_POLICY
}

/// `FrameworkVersion`'s two-state, one-way lifecycle (research.md D-3).
/// `PUBLISHED` is terminal — no operation reverts it, and (unlike
/// `ControlStatus`) there is deliberately no transition table: one edge,
/// firing at most once per version, captured as a plain field change on
/// the `FRAMEWORK_VERSION` audit entity type rather than a dedicated
/// lifecycle-transition log.
enum FrameworkVersionStatus {
  DRAFT
  PUBLISHED
}

/// The per-target-requirement result of one mapping-migration execution
/// (data-model.md §5, research.md D-6). User Story 2 (out of this
/// workstream's own scope) is the sole writer.
enum MappingMigrationOutcome {
  COPIED
  PENDING_DECISION
  SKIPPED_ALREADY_MAPPED
}

/// A requirement's derived, current compliance state (data-model.md §7,
/// research.md D-8) — never a stored column on `Requirement` itself
/// (FR-017, §19.7 of CLAUDE.md). Computed exclusively by
/// `RequirementComplianceService`; this value only ever appears as this
/// enum's runtime type, response payloads, and the observation-time
/// watermark below (`RequirementComplianceAuditMark`), never as a field
/// callers may write.
enum RequirementComplianceState {
  NOT_APPLICABLE
  NOT_MET
  NOT_PROVEN
  PARTIALLY_MET
  COMPLIANT
}

// ---------------------------------------------------------------------------
// Compliance (004-compliance-management) — the normative library (data-model.md §1-§3)
// ---------------------------------------------------------------------------

/// The normative library's root — a standard the organization responds to
/// (FR-001, data-model.md §1, ADR-017). Platform-wide catalog: no
/// `orgUnitId`, gated only by `compliance:*` permission (research.md D-2),
/// the same regime `Role`/`Permission` already use — a company-wide
/// standard must not become invisible to a caller granted only in one
/// organizational unit.
model Framework {
  id          String          @id @default(uuid(7)) @db.Uuid
  code        String          @unique
  name        String
  description String
  origin      FrameworkOrigin
  createdAt   DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic-locking version, same mechanism as `Risk.version`/
  /// `Control.version`.
  version Int @default(1)

  versions          FrameworkVersion[]
  mappingMigrations RequirementControlMappingMigration[]

  @@map("frameworks")
}

/// A revision of a `Framework` (FR-002, data-model.md §2). Two-state,
/// one-way lifecycle (research.md D-3, `FrameworkVersionStatus`) — no
/// `FrameworkVersionLifecycleTransition` table exists; publication is a
/// plain field change, audited within `FRAMEWORK_VERSION`.
model FrameworkVersion {
  id                String                 @id @default(uuid(7)) @db.Uuid
  frameworkId       String                 @map("framework_id") @db.Uuid
  /// The domain's own identifier for this revision (e.g. `"2022"`), not a
  /// generated code (research.md D-14). Unique within the framework.
  label             String
  status            FrameworkVersionStatus @default(DRAFT)
  /// Stamped by publication. Null while `DRAFT`.
  publishedAt       DateTime?              @map("published_at") @db.Timestamptz(6)
  publishedByUserId String?                @map("published_by_user_id") @db.Uuid
  createdAt         DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  version           Int                    @default(1)

  framework       Framework @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  publishedByUser User?     @relation("FrameworkVersionPublishedBy", fields: [publishedByUserId], references: [id], onDelete: Restrict)

  requirements     Requirement[]
  sourceMigrations RequirementControlMappingMigration[] @relation("MappingMigrationSource")
  targetMigrations RequirementControlMappingMigration[] @relation("MappingMigrationTarget")
  /// 005-audit-findings, T002 — a `PUBLISHED` version may be added to an
  /// audit engagement's scope (data-model.md §2, research.md D-2).
  auditScopeLinks  AuditScopeFrameworkVersion[]

  @@unique([frameworkId, label])
  @@index([frameworkId])
  @@map("framework_versions")
}

/// A clause of a `FrameworkVersion` (FR-003, data-model.md §3). Pertains to
/// exactly one version, never to the framework directly. Immutable once
/// the parent version is `PUBLISHED` — enforced both by the owning use
/// case (`UpdateRequirementUseCase`) and, as the real guarantee, by the
/// `requirements_immutable_after_publish` database trigger (research.md
/// D-4).
model Requirement {
  id                 String   @id @default(uuid(7)) @db.Uuid
  frameworkVersionId String   @map("framework_version_id") @db.Uuid
  /// The clause's own identifier in the norm (e.g. `"A.5.16"`). Not
  /// deduplicated across versions of different norms (FR-007); not unique
  /// even within a version (data-model.md §3).
  externalRef        String   @map("external_ref")
  title              String
  description        String
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  /// Changes only while the parent version is `DRAFT` — see this model's
  /// own header.
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdByUserId    String   @map("created_by_user_id") @db.Uuid
  version            Int      @default(1)

  frameworkVersion FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  createdByUser    User             @relation("RequirementCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  controlLinks              RequirementControlLink[]
  applicabilityDeclarations RequirementApplicabilityDeclaration[]
  complianceAuditMark       RequirementComplianceAuditMark?
  mappingMigrationTargetOf  RequirementControlMappingMigrationItem[]
  /// 005-audit-findings, T002 — a requirement of a `PUBLISHED` version may
  /// be added to an audit engagement's scope (data-model.md §3).
  auditScopeLinks           AuditScopeRequirement[]

  @@index([frameworkVersionId, externalRef])
  @@map("requirements")
}

// ---------------------------------------------------------------------------
// Compliance (004-compliance-management) — mapping, migration, applicability
// and compliance state (data-model.md §4-§7). User Story 2/3 (out of this
// workstream's own scope) own the domain/application/presentation code
// that writes these tables; the schema ships now so Fase 1 delivers every
// table the feature needs in one reviewed pass.
// ---------------------------------------------------------------------------

/// The explicit N:M mapping between a requirement and the controls that
/// satisfy it (FR-008, data-model.md §4, ADR-017, ADR-020). Same shape as
/// `ControlProcessLink`/`ControlAssetLink`, on the side that registers the
/// relationship (Compliance — ADR-020 part 1). Withdrawal stamps
/// `unlinkedAt`/`unlinkedByUserId` rather than deleting the row (FR-011).
///
/// **Partial unique** `(requirementId, controlId) WHERE unlinkedAt IS
/// NULL` — hand-written in the migration, same documented drift pattern as
/// `control_process_links_control_id_process_id_active_key`.
model RequirementControlLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  requirementId    String    @map("requirement_id") @db.Uuid
  controlId        String    @map("control_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  control        Control     @relation(fields: [controlId], references: [id], onDelete: Restrict)
  linkedByUser   User        @relation("RequirementControlLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?       @relation("RequirementControlLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([requirementId])
  @@map("requirement_control_links")
}

/// One migration EXECUTION carrying a mapping decision from a source
/// version to a target version of the SAME framework, as a first-class,
/// auditable event (FR-012, data-model.md §5, research.md D-6). One audit
/// event per execution — never per copied link (SC-004).
model RequirementControlMappingMigration {
  id                       String   @id @default(uuid(7)) @db.Uuid
  frameworkId              String   @map("framework_id") @db.Uuid
  sourceFrameworkVersionId String   @map("source_framework_version_id") @db.Uuid
  targetFrameworkVersionId String   @map("target_framework_version_id") @db.Uuid
  executedAt               DateTime @map("executed_at") @db.Timestamptz(6)
  executedByUserId         String   @map("executed_by_user_id") @db.Uuid

  framework              Framework        @relation(fields: [frameworkId], references: [id], onDelete: Restrict)
  sourceFrameworkVersion FrameworkVersion @relation("MappingMigrationSource", fields: [sourceFrameworkVersionId], references: [id], onDelete: Restrict)
  targetFrameworkVersion FrameworkVersion @relation("MappingMigrationTarget", fields: [targetFrameworkVersionId], references: [id], onDelete: Restrict)
  executedByUser         User             @relation("MappingMigrationExecutedBy", fields: [executedByUserId], references: [id], onDelete: Restrict)

  items RequirementControlMappingMigrationItem[]

  @@index([targetFrameworkVersionId])
  @@map("requirement_control_mapping_migrations")
}

/// One target requirement's outcome within a
/// `RequirementControlMappingMigration` execution (data-model.md §5).
model RequirementControlMappingMigrationItem {
  id                   String                  @id @default(uuid(7)) @db.Uuid
  migrationId          String                  @map("migration_id") @db.Uuid
  targetRequirementId  String                  @map("target_requirement_id") @db.Uuid
  /// Empty when `outcome = PENDING_DECISION` (research.md D-6). Plain uuid
  /// values, not an FK set — mirrors `RiskAssessment.controlsConsidered`'s
  /// own documented reason for the same shape (a snapshot, not a live
  /// relation).
  sourceRequirementIds String[]                @default([]) @map("source_requirement_ids") @db.Uuid
  outcome              MappingMigrationOutcome
  copiedLinkCount      Int                     @default(0) @map("copied_link_count")

  migration         RequirementControlMappingMigration @relation(fields: [migrationId], references: [id], onDelete: Restrict)
  targetRequirement Requirement                        @relation(fields: [targetRequirementId], references: [id], onDelete: Restrict)

  @@index([migrationId])
  @@map("requirement_control_mapping_migration_items")
}

/// A requirement declared not applicable, with mandatory justification
/// (FR-015, data-model.md §6, research.md D-7). A succession of events,
/// never a rewritten flag — reverting stamps `revokedAt`/`revokedByUserId`
/// rather than deleting the row, the same technique
/// `RequirementControlLink`/`ControlProcessLink` already use for
/// withdrawal.
///
/// **Partial unique** `(requirementId) WHERE revokedAt IS NULL` — at most
/// one active declaration per requirement — hand-written in the migration.
model RequirementApplicabilityDeclaration {
  id               String    @id @default(uuid(7)) @db.Uuid
  requirementId    String    @map("requirement_id") @db.Uuid
  justification    String
  declaredAt       DateTime  @map("declared_at") @db.Timestamptz(6)
  declaredByUserId String    @map("declared_by_user_id") @db.Uuid
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  revokedByUserId  String?   @map("revoked_by_user_id") @db.Uuid

  requirement    Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  declaredByUser User        @relation("RequirementApplicabilityDeclaredBy", fields: [declaredByUserId], references: [id], onDelete: Restrict)
  revokedByUser  User?       @relation("RequirementApplicabilityRevokedBy", fields: [revokedByUserId], references: [id], onDelete: Restrict)

  @@index([requirementId])
  @@map("requirement_applicability_declarations")
}

/// Bookkeeping-only watermark of the last OBSERVED compliance state of a
/// requirement (data-model.md §7, research.md D-11) — never consulted to
/// answer "what is the current state" (that is always
/// `RequirementComplianceService`, recomputed from source data on every
/// read). Written only as the side effect of the observation-time
/// comparison that emits `REQUIREMENT_COMPLIANCE_STATE` when the fresh
/// value differs from this row.
model RequirementComplianceAuditMark {
  requirementId    String                     @id @map("requirement_id") @db.Uuid
  lastAuditedState RequirementComplianceState @map("last_audited_state")
  lastAuditedAt    DateTime                   @map("last_audited_at") @db.Timestamptz(6)

  requirement Requirement @relation(fields: [requirementId], references: [id], onDelete: Restrict)

  @@map("requirement_compliance_audit_marks")
}

// ---------------------------------------------------------------------------
// Audit & Findings (005-audit-findings) - closed-set enums (data-model.md §8)
// ---------------------------------------------------------------------------

/// AuditEngagement's lifecycle (research.md D-3, amended at the analysis
/// gate - FR-004a). Four states, four forward edges:
/// PLANNING -> IN_PROGRESS -> COMPLETED (linear, irreversible) plus
/// PLANNING -> CANCELLED / IN_PROGRESS -> CANCELLED (the discard path).
/// CANCELLED is NOT optional - without it an engagement opened by mistake
/// (or abandoned before it has scope) can neither advance (starting
/// requires scope, FR-003) nor be removed (no delete operation exists), so
/// it would be stuck forever: the exact unreachable-state defect
/// FindingStatus (Fase 1) shipped with and ControlStatus.DRAFT (Fase 2)
/// nearly shipped with, corrected here at the SAME analysis gate before any
/// code existed, per spec.md FR-004a's own correction note. COMPLETED and
/// CANCELLED are both terminal.
enum AuditEngagementStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// ---------------------------------------------------------------------------
// Audit & Findings (005-audit-findings) - the engagement and its scope
// (data-model.md §1-§4)
// ---------------------------------------------------------------------------

/// The audit engagement - the work that examines a declared scope, produces
/// findings attributable to itself, and tracks them to remediation (US1,
/// FR-001-FR-004a). modules/audit-engagements owns this table; its
/// resource namespace is audit-engagement:*, never audit:* (already the
/// CORE audit-trail read permission, FR-019).
model AuditEngagement {
  id        String @id @default(uuid(7)) @db.Uuid
  /// AUD-2026-0001 (R-008, reusing the shared GrcCodeSequence allocator -
  /// data-model.md §1/§8, research.md D-8).
  code      String @unique
  objective String

  periodStart DateTime @map("period_start") @db.Date
  periodEnd   DateTime @map("period_end") @db.Date

  orgUnitId         String @map("org_unit_id") @db.Uuid
  leadAuditorUserId String @map("lead_auditor_user_id") @db.Uuid

  status AuditEngagementStatus @default(PLANNING)

  /// Stamped together by POST /audits/{id}/start. Null in PLANNING.
  startedAt                 DateTime? @map("started_at") @db.Timestamptz(6)
  startedByUserId           String?   @map("started_by_user_id") @db.Uuid
  /// Stamped together by POST /audits/{id}/complete. Null before
  /// COMPLETED.
  completedAt               DateTime? @map("completed_at") @db.Timestamptz(6)
  completedByUserId         String?   @map("completed_by_user_id") @db.Uuid
  /// Stamped together by the discard path (FR-004a). Null unless
  /// CANCELLED. cancellationJustification is REQUIRED by the application
  /// layer whenever this column is set - not a database CHECK, the same
  /// "not a column-level invariant" reasoning data-model.md already
  /// applies to periodEnd >= periodStart.
  cancelledAt               DateTime? @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId         String?   @map("cancelled_by_user_id") @db.Uuid
  cancellationJustification String?   @map("cancellation_justification")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  /// Optimistic lock (research.md D-18) - same mechanism as
  /// Control.version/FrameworkVersion.version.
  version Int @default(1)

  orgUnit         OrganizationalUnit @relation("AuditEngagementOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  leadAuditor     User               @relation("AuditEngagementLeadAuditor", fields: [leadAuditorUserId], references: [id], onDelete: Restrict)
  startedByUser   User?              @relation("AuditEngagementStartedBy", fields: [startedByUserId], references: [id], onDelete: Restrict)
  completedByUser User?              @relation("AuditEngagementCompletedBy", fields: [completedByUserId], references: [id], onDelete: Restrict)
  cancelledByUser User?              @relation("AuditEngagementCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  scopeFrameworkVersions AuditScopeFrameworkVersion[]
  scopeRequirements      AuditScopeRequirement[]
  scopeControls          AuditScopeControl[]
  findings               Finding[]

  @@index([orgUnitId, status])
  @@index([leadAuditorUserId])
  @@map("audit_engagements")
}

/// One FrameworkVersion added to an engagement's scope (FR-005, FR-006,
/// data-model.md §2, research.md D-2). Points at the specific, immutable-
/// once-PUBLISHED version row - never at the version-agnostic Framework -
/// so the recorded scope survives a later revision of the standard without
/// a second snapshot mechanism. No unlinkedAt - this table has no removal
/// operation (research.md D-12): a mistaken entry is corrected by adding
/// the right one, never by removing the wrong one.
model AuditScopeFrameworkVersion {
  id                 String   @id @default(uuid(7)) @db.Uuid
  auditEngagementId  String   @map("audit_engagement_id") @db.Uuid
  frameworkVersionId String   @map("framework_version_id") @db.Uuid
  linkedAt           DateTime @map("linked_at") @db.Timestamptz(6)
  linkedByUserId     String   @map("linked_by_user_id") @db.Uuid

  auditEngagement  AuditEngagement  @relation(fields: [auditEngagementId], references: [id], onDelete: Restrict)
  frameworkVersion FrameworkVersion @relation(fields: [frameworkVersionId], references: [id], onDelete: Restrict)
  linkedByUser     User             @relation("AuditScopeFrameworkVersionLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([auditEngagementId, frameworkVersionId])
  @@index([auditEngagementId])
  @@map("audit_scope_framework_versions")
}

/// One Requirement added to an engagement's scope - sibling of
/// AuditScopeFrameworkVersion above, same reasoning (FR-005, FR-006,
/// data-model.md §3). No unlinkedAt (research.md D-12).
model AuditScopeRequirement {
  id                String   @id @default(uuid(7)) @db.Uuid
  auditEngagementId String   @map("audit_engagement_id") @db.Uuid
  requirementId     String   @map("requirement_id") @db.Uuid
  linkedAt          DateTime @map("linked_at") @db.Timestamptz(6)
  linkedByUserId    String   @map("linked_by_user_id") @db.Uuid

  auditEngagement AuditEngagement @relation(fields: [auditEngagementId], references: [id], onDelete: Restrict)
  requirement     Requirement     @relation(fields: [requirementId], references: [id], onDelete: Restrict)
  linkedByUser    User            @relation("AuditScopeRequirementLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([auditEngagementId, requirementId])
  @@index([auditEngagementId])
  @@map("audit_scope_requirements")
}

/// One Control added to an engagement's scope directly (FR-005,
/// data-model.md §4) - distinct from FindingControlLink below: this table
/// records what the EXAM covered, that one records what a FINDING points
/// to. No unlinkedAt (research.md D-12).
model AuditScopeControl {
  id                String   @id @default(uuid(7)) @db.Uuid
  auditEngagementId String   @map("audit_engagement_id") @db.Uuid
  controlId         String   @map("control_id") @db.Uuid
  linkedAt          DateTime @map("linked_at") @db.Timestamptz(6)
  linkedByUserId    String   @map("linked_by_user_id") @db.Uuid

  auditEngagement AuditEngagement @relation(fields: [auditEngagementId], references: [id], onDelete: Restrict)
  control         Control         @relation(fields: [controlId], references: [id], onDelete: Restrict)
  linkedByUser    User            @relation("AuditScopeControlLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)

  @@unique([auditEngagementId, controlId])
  @@index([auditEngagementId])
  @@map("audit_scope_controls")
}

// ---------------------------------------------------------------------------
// Audit & Findings (005-audit-findings) - the two Finding relationships
// Phase 1 deferred (data-model.md §5-§6, ADR-020 parts 1/2). Owned by
// grc/finding (the side that registers, ADR-020 part 1); schema-only here -
// the domain/application/presentation code that writes these tables is
// Fase 5/User Story 3 (out of this task's own scope, per this task's own
// instructions: T001-T037/T034a/T034b only).
// ---------------------------------------------------------------------------

/// A finding pointing at a control it implicates (FR-013-FR-016). Same
/// shape as RiskControlLink. unlinkedAt/unlinkedByUserId preserve a
/// withdrawn link rather than deleting the row (FR-016).
///
/// Partial unique (findingId, controlId) WHERE unlinkedAt IS NULL -
/// hand-written in the migration (Prisma has no partial-index syntax),
/// same documented drift pattern as RequirementControlLink.
model FindingControlLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  findingId        String    @map("finding_id") @db.Uuid
  controlId        String    @map("control_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  finding        Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  control        Control @relation(fields: [controlId], references: [id], onDelete: Restrict)
  linkedByUser   User    @relation("FindingControlLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?   @relation("FindingControlLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([findingId, unlinkedAt])
  @@map("finding_control_links")
}

/// A finding pointing at a risk it materializes - sibling of
/// FindingControlLink above, same reasoning (FR-013-FR-016).
///
/// Partial unique (findingId, riskId) WHERE unlinkedAt IS NULL -
/// hand-written in the migration, same drift pattern as above.
model FindingRiskLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  findingId        String    @map("finding_id") @db.Uuid
  riskId           String    @map("risk_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  finding        Finding @relation(fields: [findingId], references: [id], onDelete: Restrict)
  risk           Risk    @relation(fields: [riskId], references: [id], onDelete: Restrict)
  linkedByUser   User    @relation("FindingRiskLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?   @relation("FindingRiskLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([findingId, unlinkedAt])
  @@map("finding_risk_links")
}

// ---------------------------------------------------------------------------
// 008-incidents-problems — foundation (spec.md, data-model.md, research.md).
// Two business-module entities, five link tables. Migration:
// `20260911020000_incidents_problems_foundation_baseline`. Schema-only in
// this pass — the domain/application/presentation code that writes these
// tables is Fase 3-5's own scope (tasks.md), except where noted.
// ---------------------------------------------------------------------------

enum IncidentSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// data-model.md D-4 (research.md) — five states, each with an observable
/// consequence (the same "no dead-end state" bar `003-controls-management`
/// T025 already tests). `OPEN -> IN_PROGRESS -> RESOLVED -> CLOSED`, with
/// `CANCELLED` a terminal escape from `OPEN`/`IN_PROGRESS`, and
/// `RESOLVED -> IN_PROGRESS` the one reopening edge (requires a reason).
enum IncidentStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
  CANCELLED
}

enum ProblemSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

/// data-model.md D-5 — same five-state shape as `IncidentStatus`, with
/// `IN_ANALYSIS` in place of `IN_PROGRESS` (root-cause investigation, not a
/// mitigation in progress). `CLOSED` is gated (invariants P1-P3): requires
/// `rootCause` populated, a `COMPLETED` `Action` of origin `PROBLEM`, and a
/// closer different from whoever completed that action.
enum ProblemStatus {
  OPEN
  IN_ANALYSIS
  RESOLVED
  CLOSED
  CANCELLED
}

/// data-model.md §1, D-8 (research.md) — `orgUnitId` is a required,
/// non-nullable column, following `Risk`/`Finding`'s own precedent, not the
/// nullable-column pattern `Asset`/`Process`/`Control` use: unlike those,
/// no legacy row of `Incident` predates this migration, so there is no
/// "increase visibility of an existing row" hazard to avoid (research.md
/// D-8 rejects replicating the nullable-column form for exactly this
/// reason).
///
/// Invariants I1/I2 (domain-enforced, not CHECK — same technique
/// `Finding.closureJustification` already uses): `resolutionSummary` is
/// populated the moment `status` becomes `RESOLVED`; `cancellationReason`
/// is populated the moment `status` becomes `CANCELLED`.
model Incident {
  id                 String           @id @default(uuid(7)) @db.Uuid
  /// `INC-2026-0001` (R-008).
  code               String           @unique
  orgUnitId          String           @map("org_unit_id") @db.Uuid
  title              String
  description        String
  severity           IncidentSeverity
  status             IncidentStatus   @default(OPEN)
  reportedByUserId   String           @map("reported_by_user_id") @db.Uuid
  ownerUserId        String           @map("owner_user_id") @db.Uuid
  reportedOn         DateTime         @map("reported_on") @db.Date
  /// Invariant I1 — NOT NULL from the moment `status` becomes `RESOLVED`.
  resolutionSummary  String?          @map("resolution_summary")
  resolvedAt         DateTime?        @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId   String?          @map("resolved_by_user_id") @db.Uuid
  closedAt           DateTime?        @map("closed_at") @db.Timestamptz(6)
  closedByUserId     String?          @map("closed_by_user_id") @db.Uuid
  /// Invariant I2 — NOT NULL from the moment `status` becomes `CANCELLED`.
  cancellationReason String?          @map("cancellation_reason")
  cancelledAt        DateTime?        @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId  String?          @map("cancelled_by_user_id") @db.Uuid
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit         OrganizationalUnit @relation("IncidentOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  reportedBy      User               @relation("IncidentReportedBy", fields: [reportedByUserId], references: [id], onDelete: Restrict)
  owner           User               @relation("IncidentOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  resolvedByUser  User?              @relation("IncidentResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  closedByUser    User?              @relation("IncidentClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  cancelledByUser User?              @relation("IncidentCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  riskLinks    IncidentRiskLink[]
  assetLinks   IncidentAssetLink[]
  processLinks IncidentProcessLink[]
  /// Read-only from this side — the write path belongs to `Problem`
  /// (data-model.md §6, research.md D-14: decision of the coordinator,
  /// owned by Problems).
  problemLinks ProblemIncidentLink[]

  @@index([orgUnitId])
  @@map("incidents")
}

/// data-model.md §1 — same shape as `Incident` above, with `identifiedOn`/
/// `rootCause` in place of `reportedOn`/`resolutionSummary` (a problem has
/// no separate reporter distinct from its owner — it originates from
/// analysis, not a third-party report). Invariants P1-P3 are
/// domain-enforced (data-model.md §4):
///
///   * P1 — `rootCause` NOT NULL the moment `status` becomes `RESOLVED`.
///   * P2 — `status` may become `CLOSED` only if an `Action` with
///     `originType = 'PROBLEM'`, `originId = problems.id`,
///     `status = 'COMPLETED'` exists — reverified at transition time, never
///     cached on this row.
///   * P3 — the transitioning user (`closedByUserId`) must differ from the
///     `Action`'s own `completedByUserId` (segregation of duties, the same
///     technique `Finding`'s own close/reopen pair already uses).
model Problem {
  id                 String          @id @default(uuid(7)) @db.Uuid
  /// `PRB-2026-0001` (R-008).
  code               String          @unique
  orgUnitId          String          @map("org_unit_id") @db.Uuid
  title              String
  description        String
  severity           ProblemSeverity
  status             ProblemStatus   @default(OPEN)
  ownerUserId        String          @map("owner_user_id") @db.Uuid
  identifiedOn       DateTime        @map("identified_on") @db.Date
  /// Invariant P1 — NOT NULL from the moment `status` becomes `RESOLVED`.
  rootCause          String?         @map("root_cause")
  resolvedAt         DateTime?       @map("resolved_at") @db.Timestamptz(6)
  resolvedByUserId   String?         @map("resolved_by_user_id") @db.Uuid
  closedAt           DateTime?       @map("closed_at") @db.Timestamptz(6)
  closedByUserId     String?         @map("closed_by_user_id") @db.Uuid
  cancellationReason String?         @map("cancellation_reason")
  cancelledAt        DateTime?       @map("cancelled_at") @db.Timestamptz(6)
  cancelledByUserId  String?         @map("cancelled_by_user_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  orgUnit         OrganizationalUnit @relation("ProblemOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  owner           User               @relation("ProblemOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  resolvedByUser  User?              @relation("ProblemResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: Restrict)
  closedByUser    User?              @relation("ProblemClosedBy", fields: [closedByUserId], references: [id], onDelete: Restrict)
  cancelledByUser User?              @relation("ProblemCancelledBy", fields: [cancelledByUserId], references: [id], onDelete: Restrict)

  riskLinks     ProblemRiskLink[]
  /// Write path — `modules/problems` owns creation/withdrawal of this
  /// link, resolving the incident-target through `IncidentDirectoryPort`
  /// (`shared/grc-ports/`) rather than importing `modules/incidents`
  /// (data-model.md §6, research.md D-14).
  incidentLinks ProblemIncidentLink[]

  @@index([orgUnitId])
  @@map("problems")
}

/// data-model.md §2 — same shape as `FindingRiskLink`/`RiskAssetLink`:
/// explicit named link table, `unlinkedAt`/`unlinkedByUserId` marks
/// withdrawal rather than deleting the row (FR-012). Partial unique
/// `(incidentId, riskId) WHERE unlinkedAt IS NULL` is hand-written SQL in
/// the migration — same documented drift as every other link table's own.
model IncidentRiskLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  incidentId       String    @map("incident_id") @db.Uuid
  riskId           String    @map("risk_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  risk           Risk     @relation(fields: [riskId], references: [id], onDelete: Restrict)
  linkedByUser   User     @relation("IncidentRiskLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?    @relation("IncidentRiskLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([incidentId, unlinkedAt])
  @@map("incident_risk_links")
}

/// Sibling of `IncidentRiskLink` above, same shape and reasoning, against
/// `Asset` instead of `Risk` (data-model.md §2).
model IncidentAssetLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  incidentId       String    @map("incident_id") @db.Uuid
  assetId          String    @map("asset_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  asset          Asset    @relation(fields: [assetId], references: [id], onDelete: Restrict)
  linkedByUser   User     @relation("IncidentAssetLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?    @relation("IncidentAssetLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([incidentId, unlinkedAt])
  @@map("incident_asset_links")
}

/// Sibling of `IncidentRiskLink` above, same shape and reasoning, against
/// `Process` instead of `Risk` (data-model.md §2).
model IncidentProcessLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  incidentId       String    @map("incident_id") @db.Uuid
  processId        String    @map("process_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  process        Process  @relation(fields: [processId], references: [id], onDelete: Restrict)
  linkedByUser   User     @relation("IncidentProcessLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?    @relation("IncidentProcessLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([incidentId, unlinkedAt])
  @@map("incident_process_links")
}

/// Sibling of `IncidentRiskLink` above, same shape and reasoning, owned by
/// `Problem` instead of `Incident` (data-model.md §2).
model ProblemRiskLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  problemId        String    @map("problem_id") @db.Uuid
  riskId           String    @map("risk_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  problem        Problem @relation(fields: [problemId], references: [id], onDelete: Restrict)
  risk           Risk    @relation(fields: [riskId], references: [id], onDelete: Restrict)
  linkedByUser   User    @relation("ProblemRiskLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?   @relation("ProblemRiskLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([problemId, unlinkedAt])
  @@map("problem_risk_links")
}

/// data-model.md §2/§6 — the fifth link table, decided by the coordinator
/// (spec.md "Decisões do coordenador"; research.md D-13 to D-15): N:M,
/// optional on both sides, owned by `Problem` (the write path is
/// `POST`/`DELETE /problems/{problemId}/incidents`, resolving the
/// incident-target through `IncidentDirectoryPort` — neither module
/// imports the other, ADR-011). `Incident`'s own
/// `GET /incidents/{incidentId}/problems` reads this same table directly.
/// Never consulted by any transition invariant of either `Incident` or
/// `Problem` (data-model.md L2) — informational and auditable only.
model ProblemIncidentLink {
  id               String    @id @default(uuid(7)) @db.Uuid
  problemId        String    @map("problem_id") @db.Uuid
  incidentId       String    @map("incident_id") @db.Uuid
  linkedByUserId   String    @map("linked_by_user_id") @db.Uuid
  linkedAt         DateTime  @map("linked_at") @db.Timestamptz(6)
  unlinkedAt       DateTime? @map("unlinked_at") @db.Timestamptz(6)
  unlinkedByUserId String?   @map("unlinked_by_user_id") @db.Uuid

  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Restrict)
  incident       Incident @relation(fields: [incidentId], references: [id], onDelete: Restrict)
  linkedByUser   User     @relation("ProblemIncidentLinkLinkedBy", fields: [linkedByUserId], references: [id], onDelete: Restrict)
  unlinkedByUser User?    @relation("ProblemIncidentLinkUnlinkedBy", fields: [unlinkedByUserId], references: [id], onDelete: Restrict)

  @@index([problemId, unlinkedAt])
  @@index([incidentId, unlinkedAt])
  @@map("problem_incident_links")
}

// ---------------------------------------------------------------------------
// Indicators & Reports — foundation (009-indicators-reports, Fase 1: T001-T004)
// ---------------------------------------------------------------------------
//
// Scope of this migration is schema only — no use case, controller, or
// permission wiring (that is Fase 2 onward). See data-model.md §1-§8 and
// research.md D-1 to D-13 for the full reasoning; the summary that matters
// for reading the models below:
//
//   * Neither `IndicatorDefinition` nor `IndicatorMeasurement` nor
//     `ReportDefinition` has an `orgUnitId` column (research.md D-6/D-8).
//     This is a DELIBERATE, PERMANENT decision, not an oversight — do not
//     "fix" it later without a new decision recorded in research.md.
//     `IndicatorDefinition`/`ReportDefinition` are shared, organization-wide
//     configuration (the same pattern `Framework`/`FrameworkVersion` already
//     use). `IndicatorMeasurement` is, by construction, always an
//     organization-wide snapshot (`ScopeFilter.kind === 'GLOBAL'` is
//     enforced by the application layer that writes/reads it, never by a
//     column here). The scope predicate for the CURRENT value of an
//     indicator (US1) is applied by each `IndicatorMetricProvider` against
//     its own source table's own `orgUnitId` column — never here, never by
//     inference through a join (CLAUDE.md §19.3).
//   * No "current value" column exists anywhere in this section
//     (CLAUDE.md §19.7, research.md D-2): a current value is always
//     computed on read, by the single future `IndicatorCalculationService`.
//     `IndicatorMeasurement` is the one place a value IS stored, because it
//     is a historical fact, not derived state — the same distinction that
//     already separates `RiskAssessment` (stored) from a risk's live score
//     (computed by `RiskScoringService`, never stored).

/// data-model.md §3 (research.md D-4) — closed platform enum, one member per
/// domain metric this phase's catalog covers. Each value's metadata
/// (`sourcePermission`/`scopeApplicability`/`shape`) lives in code
/// (`IndicatorMetricCatalog`, Fase 2), never in this schema. Adding a
/// twelfth key, in the future, requires an additive migration AND a new
/// `IndicatorMetricProvider` that implements it — never a client-composable
/// query (CLAUDE.md §19.3/§19.10).
enum IndicatorMetricKey {
  RISK_TOTAL_BY_LEVEL
  RISK_TREATMENT_OVERDUE_COUNT
  CONTROL_INACTIVE_COUNT
  COMPLIANCE_PERCENTAGE
  AUDIT_ENGAGEMENT_OPEN_COUNT
  FINDING_OPEN_COUNT_BY_SEVERITY
  ASSET_INACTIVE_COUNT
  PROCESS_INACTIVE_COUNT
  ACTION_OVERDUE_COUNT
  INCIDENT_OPEN_COUNT_BY_SEVERITY
  PROBLEM_OPEN_COUNT_BY_SEVERITY
}

/// data-model.md §4 — four comparators only: greater-or-equal, greater,
/// less-or-equal, less. No `EQ`/`NEQ` — a GRC indicator threshold is always
/// "must not exceed"/"must not fall below" a bound, never "must equal
/// exactly" (a computed value, such as a count, rarely lands on one exact
/// number, and no requirement of this phase asks for that case).
enum IndicatorThresholdComparator {
  GTE
  GT
  LTE
  LT
}

/// data-model.md §1 (research.md D-2/D-8) — the only editable half of an
/// Indicator: name, source metric, threshold, owner. NEVER a stored
/// "current value" column — see the section header above (CLAUDE.md §19.7).
///
/// `metricKey` is `@unique`: at most one definition per catalog key
/// (data-model.md §1/research.md D-2) — a definition is optional
/// configuration for a key that is already queryable without it
/// (`GET /indicators/{metricKey}/current` works with zero rows here), and a
/// second definition for the same key would leave "which definition's
/// threshold decides `breached`, and who is notified?" without a single
/// answer.
///
/// DELIBERATELY no `orgUnitId` column (research.md D-8) — see the section
/// header above.
///
/// No delete path (spec.md FR-003): an indicator that stops being relevant
/// is deactivated (`isActive = false`), never removed — the same pattern
/// `Asset`/`Process`/`Control` already follow.
///
/// Invariant T1 (domain-enforced, NOT a CHECK constraint — the same
/// technique `Finding.closureJustification` already uses): `threshold
/// Comparator`/`thresholdValue` are populated together, or neither is. A
/// comparator without a value (or vice versa) has no evaluable meaning.
model IndicatorDefinition {
  id                  String                        @id @default(uuid(7)) @db.Uuid
  /// `IND-2026-0001` (R-008).
  code                String                        @unique
  metricKey           IndicatorMetricKey            @unique @map("metric_key")
  name                String
  description         String
  ownerUserId         String                        @map("owner_user_id") @db.Uuid
  /// Invariant T1 — populated together with `thresholdValue`, or neither.
  thresholdComparator IndicatorThresholdComparator? @map("threshold_comparator")
  /// Invariant T1 — populated together with `thresholdComparator`, or
  /// neither. `@db.Decimal` with no precision/scale, matching data-model.md's
  /// unbounded `numeric` column — this phase does not constrain the range
  /// of a threshold value.
  thresholdValue      Decimal?                      @map("threshold_value") @db.Decimal
  isActive            Boolean                       @default(true) @map("is_active")
  createdByUserId     String                        @map("created_by_user_id") @db.Uuid
  createdAt           DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)

  owner     User @relation("IndicatorDefinitionOwner", fields: [ownerUserId], references: [id], onDelete: Restrict)
  createdBy User @relation("IndicatorDefinitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("indicator_definitions")
}

/// data-model.md §2 (research.md D-2/D-6/D-7) — append-only history of a
/// computed indicator value. NEVER add an UPDATE/DELETE path, and NEVER add
/// an `updatedAt` column — no operation on this table is anything but
/// INSERT (spec.md SC-002).
///
/// `metricKey` references the CATALOG KEY directly, NOT
/// `IndicatorDefinition.id` — deliberately no foreign key to
/// `indicator_definitions` (data-model.md §2/§6): a measurement stays
/// gravable even when no `IndicatorDefinition` has been configured yet for
/// that key. What depends on a definition existing is only whether
/// `breached` can ever be `true` (without one, always `false`, spec.md
/// FR-019) and whether a breach notification fires (US3) — never whether
/// the point itself can be recorded.
///
/// DELIBERATELY no `orgUnitId`, no `code` column — see the section header
/// above for `orgUnitId`; no code because the natural, stable identifier
/// for display is already `(metricKey, computedAt)` (research.md D-9, the
/// same reasoning `FrameworkVersion`/`Requirement` already established for
/// not having a code of their own).
///
/// Invariant M1 (domain-enforced, NOT a CHECK constraint): exactly one of
/// `value`/`valueByBucket` is populated, never both, never neither — which
/// one depends on the `shape` of `metricKey` in `IndicatorMetricCatalog`
/// (Fase 2): a single-number metric (e.g. `COMPLIANCE_PERCENTAGE`) uses
/// `value`; a by-bucket metric (e.g. `RISK_TOTAL_BY_LEVEL`) uses
/// `valueByBucket`.
model IndicatorMeasurement {
  id               String             @id @default(uuid(7)) @db.Uuid
  metricKey        IndicatorMetricKey @map("metric_key")
  /// Invariant M1 — populated when the metric's shape is `SINGLE_VALUE`.
  /// `@db.Decimal` with no precision/scale — same reasoning as
  /// `IndicatorDefinition.thresholdValue` above.
  value            Decimal?           @db.Decimal
  /// Invariant M1 — populated when the metric's shape is `BY_BUCKET`, one
  /// key per value of the corresponding domain enum (e.g. `RiskLevel`) —
  /// the same zero-filled shape `RiskProfileRecord.byResidualLevel` already
  /// uses (`dashboard-query.port.ts`).
  valueByBucket    Json?              @map("value_by_bucket")
  /// Computed once, at creation, against whatever `IndicatorDefinition`
  /// threshold existed for `metricKey` at that instant (research.md D-7) —
  /// NEVER recalculated afterward, even if the definition's threshold
  /// changes later.
  breached         Boolean
  computedAt       DateTime           @default(now()) @map("computed_at") @db.Timestamptz(6)
  computedByUserId String             @map("computed_by_user_id") @db.Uuid

  computedByUser User @relation("IndicatorMeasurementComputedBy", fields: [computedByUserId], references: [id], onDelete: Restrict)

  /// data-model.md §7 — every access to this table is "history of one
  /// indicator, ordered in time" (spec.md FR-015); no query makes sense
  /// without the first filter.
  @@index([metricKey, computedAt])
  @@map("indicator_measurements")
}

/// data-model.md §1 (research.md D-1/D-11) — a named, saved cross-domain
/// report: which `IndicatorMetricKey`s it composes.
///
/// `metricKeys` is an array of the same closed enum, NOT a foreign key to a
/// join table (data-model.md §1/§6): `IndicatorMetricKey` is an enum value,
/// not a database row — there is no "row" for a junction table to
/// reference. Non-empty is validated in the application layer; Prisma/
/// PostgreSQL do not express "array not empty" at the column level.
///
/// DELIBERATELY no `orgUnitId` column — see the section header above, same
/// reasoning as `IndicatorDefinition`. DELIBERATELY no history table for
/// this model (spec.md FR-028): only the individual indicator has a time
/// series — a report is re-run on demand, never snapshotted.
model ReportDefinition {
  id              String               @id @default(uuid(7)) @db.Uuid
  /// `RPT-2026-0001` (R-008).
  code            String               @unique
  name            String
  description     String
  /// `@default([])` is what makes Prisma emit `NOT NULL` for this column
  /// (data-model.md §1 declares it `NOT NULL`) — a scalar list field with
  /// no default is otherwise created nullable. The default itself is never
  /// actually relied on: the application layer always sets this array
  /// explicitly at creation and rejects an empty one (data-model.md §1's
  /// own "não vazio — validado na aplicação").
  metricKeys      IndicatorMetricKey[] @default([]) @map("metric_keys")
  isActive        Boolean              @default(true) @map("is_active")
  createdByUserId String               @map("created_by_user_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  createdBy User @relation("ReportDefinitionCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)

  @@map("report_definitions")
}
