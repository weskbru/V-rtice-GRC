# .env.example
#
# Every environment variable the PharosGRC platform reads, grouped and
# commented (T011). Copy this file to `.env` and adjust as needed:
#   Copy-Item .env.example .env
#
# No real secret belongs in this file, in the repository, or in `.env`
# committed anywhere. Every value below is either a safe development default
# (explicitly labelled) or intentionally left blank because it must be
# supplied by the operator. In production every value is supplied by the
# deployment environment or a secret manager, never by a checked-in file.
#
# Variable names follow specs/001-grc-platform-foundation/quickstart.md,
# the authoritative naming source for this project.

# -----------------------------------------------------------------------------
# Application / runtime
# -----------------------------------------------------------------------------

# Runtime mode; gates cookie hardening, error verbosity and log formatting.
# Required. One of: development | test | production.
NODE_ENV=development

# NestJS API listen port. Required.
API_PORT=3001

# Next.js listen port. Required.
WEB_PORT=3000

# Base URL the web app (server-side rewrites/fetches) uses to reach the API.
# Required. Points at the API directly in local dev; inside Docker Compose it
# is overridden to http://api:3001 (see docker-compose.yml).
API_INTERNAL_URL=http://localhost:3001

# The single public origin of the deployment (ADR-014). Required. Used to
# validate the Origin/Referer header on every state-changing request
# (CSRF defense, T065) — a request whose Origin does not match this value is
# rejected with 403.
APP_ORIGIN=http://localhost:3000

# -----------------------------------------------------------------------------
# Database — PostgreSQL (ADR-005: two roles, owner for migrations, restricted
# role for the running application)
# -----------------------------------------------------------------------------
# This machine develops against a NATIVE PostgreSQL 18 instance on the default
# port 5432 (not the Docker Compose stack), already provisioned with:
#   database `pharos_grc` (dev) and `pharos_grc_test` (tests), both owned by
#   `pharos_owner`; role `pharos_owner`/`pharos_owner_dev` (migration/owner);
#   role `pharos_app`/`pharos_app_dev` (restricted application role);
#   extensions pg_trgm and citext installed in both databases.
# The defaults below target that native instance. The commented-out pair
# below them targets the Docker Compose stack instead (docker-compose.yml,
# host port 5433) when running everything containerized.

# Application connection. Required. Uses the RESTRICTED role only —
# INSERT/SELECT/UPDATE/DELETE on ordinary tables, never DDL, never
# UPDATE/DELETE on audit_event.
DATABASE_URL=postgresql://pharos_app:pharos_app_dev@localhost:5432/pharos_grc?schema=public

# Migration connection. Required. Uses the OWNER role — the only role Prisma
# `migrate` ever runs as. The application must never run with this role.
DATABASE_MIGRATION_URL=postgresql://pharos_owner:pharos_owner_dev@localhost:5432/pharos_grc?schema=public

# --- Alternative: point at the Docker Compose stack (docker-compose.yml)
# --- instead of the native local PostgreSQL. Uncomment both and comment out
# --- the pair above.
# DATABASE_URL=postgresql://pharos_app:pharos_app_dev@localhost:5433/pharos_grc?schema=public
# DATABASE_MIGRATION_URL=postgresql://pharos_owner:pharos_owner_dev@localhost:5433/pharos_grc?schema=public

# Integration/contract/e2e test connections. Required for running the test
# suites. Point at the native `pharos_grc_test` database on 5432 by default;
# swap to docker-compose.test.yml's host port (5434) when using that stack.
TEST_DATABASE_URL=postgresql://pharos_app:pharos_app_dev@localhost:5432/pharos_grc_test?schema=public
TEST_DATABASE_MIGRATION_URL=postgresql://pharos_owner:pharos_owner_dev@localhost:5432/pharos_grc_test?schema=public
# TEST_DATABASE_URL=postgresql://pharos_app:pharos_app_dev@localhost:5434/pharos_grc_test?schema=public
# TEST_DATABASE_MIGRATION_URL=postgresql://pharos_owner:pharos_owner_dev@localhost:5434/pharos_grc_test?schema=public

# -----------------------------------------------------------------------------
# Cache — Redis (ADR-002/003/004: cache and rate-limit counters only, never
# authoritative)
# -----------------------------------------------------------------------------

# Optional. Leave EMPTY for local development without Redis — Redis is not
# installable on this machine, so the cache port falls back to an in-process
# in-memory adapter (sessions/permissions/scope are still correct, just not
# shared across processes or survivable across a restart). REQUIRED in
# production and in any multi-instance deployment, where the in-memory
# adapter would give each instance an inconsistent view.
REDIS_URL=

# -----------------------------------------------------------------------------
# Sessions (ADR-002)
# -----------------------------------------------------------------------------

# Name of the opaque, httpOnly session cookie. Required.
#
# NOTE (T050-T069 implementation): quickstart.md's env-var table previously
# documented `pharos_sid` as the sample default here, but every OpenAPI
# contract in specs/001-grc-platform-foundation/contracts/ (auth, admin,
# platform, risks — four independent documents, all in agreement) hardcodes
# the cookie's securityScheme name as `pgrc_session`. Since a frontend agent
# builds against those contracts literally, this default is changed to
# `pgrc_session` to match them exactly — the value stays fully
# operator-configurable via this variable (never hardcoded in application
# code), this only changes what ships as the out-of-the-box default.
SESSION_COOKIE_NAME=pgrc_session

# Sets the cookie's `Secure` flag. Required. `false` ONLY for local HTTP
# development; must be `true` in every other environment (the cookie is then
# refused over plain HTTP, which is why this must stay `false` for
# http://localhost dev).
#
# NOTE (F-13): this file's default stays `false` because it is also what
# native `pnpm dev` on http://localhost reads directly. docker-compose.yml's
# `api` service hardcodes NODE_ENV=production, which env.schema.ts correctly
# refuses to boot with SESSION_COOKIE_SECURE=false — so that service
# overrides this value to `true` for its own container, the same way it
# overrides DATABASE_URL/REDIS_URL to Compose-network values. Copying this
# file verbatim to `.env` and running `docker compose up` therefore boots
# correctly; this default only governs the native host path. That override
# does not by itself make the cookie usable from a real browser — nothing in
# docker-compose.yml terminates TLS, so a browser would still refuse to
# store a `Secure` cookie served over plain http://localhost.
SESSION_COOKIE_SECURE=false

# SameSite policy on the session cookie. Required. Blocks cross-site form
# posts as part of the CSRF defense described in ADR-002.
SESSION_COOKIE_SAMESITE=lax

# Sliding inactivity expiry, in minutes (FR-014). Required. Runtime
# configurable per T015.
SESSION_IDLE_TIMEOUT_MINUTES=30

# Absolute session lifetime regardless of activity, in hours (FR-014).
# Required. Runtime configurable per T015.
SESSION_ABSOLUTE_LIFETIME_HOURS=12

# -----------------------------------------------------------------------------
# Password policy (FR-006)
# -----------------------------------------------------------------------------

# Minimum local-account password length. Required.
PASSWORD_MIN_LENGTH=12

# Enforce mixed character classes (upper/lower/digit/symbol) on local-account
# passwords. Required.
PASSWORD_REQUIRE_COMPLEXITY=true

# -----------------------------------------------------------------------------
# Password hashing — argon2id (ADR-001)
# -----------------------------------------------------------------------------

# Memory cost in KiB. Required.
ARGON2_MEMORY_COST=19456

# Time cost (iterations). Required.
ARGON2_TIME_COST=2

# Parallelism (lanes). Required.
ARGON2_PARALLELISM=1

# -----------------------------------------------------------------------------
# Logging (ADR-012)
# -----------------------------------------------------------------------------

# pino log level. Required. One of: fatal|error|warn|info|debug|trace.
LOG_LEVEL=debug

# Human-readable (pino-pretty) log output for local development. Required.
# Set to `false` in every non-interactive environment (structured JSON logs).
LOG_PRETTY=true

# -----------------------------------------------------------------------------
# Rate limiting and authentication throttling (T066, FR-008)
# -----------------------------------------------------------------------------

# Global API rate-limit window, in seconds, for the @nestjs/throttler budget.
# Required. Distinct from the auth-specific limits below.
THROTTLE_TTL_SECONDS=60

# Maximum requests per client within THROTTLE_TTL_SECONDS. Required.
THROTTLE_LIMIT=100

# Failed sign-in attempts allowed for a single account before it is locked
# out (FR-008). Required. FR-008's own security-conscious value ("kept low —
# a shared account is a higher-value target than a shared network") is `5`,
# and that is exactly what production reads: this file's values are NEVER
# consulted in production (see this file's own header) — production supplies
# every value itself, through the deployment environment or a secret
# manager, never through a copy of this template.
#
# F-48/D-23 (`docs/deferred-findings.md`, `docs/local-environment.md`): this
# TEMPLATE's own default is `200`, not `5` — deliberately matching
# `.github/workflows/ci.yml`'s three `test-e2e*` jobs (never its
# `test-integration`/`test-contract`/`test-unit` jobs, which keep `5`), not
# production. The reason is entirely mechanical, not a relaxed security
# posture: `apps/web/e2e/support/admin-session.ts`'s own sign-in helper
# tries the rotated password first and only falls back to the plain one on
# a genuine refusal — on a database an earlier run already touched (every
# local dev database, by design; never CI's own fresh-per-run one), that
# fallback costs one guaranteed failed attempt per account, per spec file,
# by construction, not by any test being broken. `5` locks a real developer
# out of their own machine partway through one Chromium run of the E2E
# suite; CI's E2E jobs hit the exact same mechanical cost and raise the
# budget for exactly that job, never for `test-integration`/`test-contract`/
# `test-unit`, which never touch this path. This file follows the profile CI
# already ratified for the SAME workload (local `pnpm dev` + Playwright is
# that workload) rather than the unrelated one production happens to share
# a number with by coincidence.
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=200

# Failed sign-in attempts allowed from a single origin (IP/proxy) across ALL
# accounts before that origin is throttled (FR-008). Required. Kept higher
# than the per-account limit so a shared corporate NAT/VPN egress is not
# locked out by a handful of individual mistyped passwords (D-6).
#
# F-48/D-23: `1000`, not `20`, for the identical reason given above for
# `AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS` — every local E2E worker's provisioning
# and sign-in traffic shares this one machine's loopback origin, multiplying
# the same one-guaranteed-failure-per-account-per-file cost across every
# worker and every spec file in a run. `.github/workflows/ci.yml`'s
# `test-e2e*` jobs raise this to the same `1000`; its other three jobs keep
# `20`, matching production, because they never drive this login path.
AUTH_RATE_LIMIT_ORIGIN_ATTEMPTS=1000

# Window, in seconds, over which failed sign-in attempts are counted.
# Required.
AUTH_RATE_LIMIT_WINDOW_SECONDS=300

# Lockout duration, in minutes, once the attempt limit is hit. Required.
AUTH_LOCKOUT_MINUTES=15

# -----------------------------------------------------------------------------
# Attachment storage (ADR-010)
# -----------------------------------------------------------------------------

# Storage adapter behind the FileStorageProvider port. Required. Only `local`
# exists in this release; an S3-compatible adapter is a future addition
# behind the same port.
ATTACHMENT_STORAGE_DRIVER=local

# Root directory for the local-disk adapter. Required when
# ATTACHMENT_STORAGE_DRIVER is `local`. Overridden to
# /app/storage/attachments inside Docker Compose.
ATTACHMENT_STORAGE_PATH=./storage/attachments

# Per-file upload size cap, in bytes (FR-097). Required. Default 25 MiB.
ATTACHMENT_MAX_SIZE_BYTES=26214400

# Comma-separated MIME type allow-list enforced on upload (FR-097). Required.
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain

# -----------------------------------------------------------------------------
# Seed data (T042)
# -----------------------------------------------------------------------------

# Explicit flag gating the development-only fixture (one user per system
# role, a two-level organizational unit tree). Required. Must stay `false`
# outside local development — the fixture is never intended for a shared or
# production database.
SEED_DEV_FIXTURES=false

# Identifier of the seeded administrator account. Required for seeding.
SEED_ADMIN_EMAIL=admin@example.local

# Initial password for the seeded administrator, flagged `mustChangePassword`.
# Required for seeding; intentionally left BLANK here — the seed must fail
# rather than fall back to a default if this is absent or fails the password
# policy. Set it in the current shell, never in a committed file:
#   $env:SEED_ADMIN_PASSWORD = "<choose-a-strong-password>"
SEED_ADMIN_PASSWORD=

# -----------------------------------------------------------------------------
# Docker Compose only — read by docker-compose.yml / docker-compose.test.yml,
# not by the applications themselves (T009/T010)
# -----------------------------------------------------------------------------

# Host port bindings. Required (defaults shown avoid colliding with the
# native local PostgreSQL on 5432 — see docker-compose.yml header comment).
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379
TEST_POSTGRES_HOST_PORT=5434
TEST_REDIS_HOST_PORT=6380

# Database names created inside the Compose Postgres containers. Required.
POSTGRES_DB=pharos_grc
TEST_POSTGRES_DB=pharos_grc_test

# Bootstrap Postgres superuser password inside the Compose container only
# (never used by the application). Required. Dev-only default.
POSTGRES_SUPERUSER_PASSWORD=postgres_dev_only

# Owner/migration role provisioned inside the Compose Postgres container by
# docker/postgres/init/01-roles.sql. Required. Dev-only defaults — matches the
# native role names above so the same DATABASE_MIGRATION_URL shape works
# against either target.
POSTGRES_OWNER_USER=pharos_owner
POSTGRES_OWNER_PASSWORD=pharos_owner_dev

# Restricted application role provisioned the same way. Required. Dev-only
# defaults.
POSTGRES_APP_USER=pharos_app
POSTGRES_APP_PASSWORD=pharos_app_dev
