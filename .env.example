# Template local: copie para .env e substitua todos os CHANGE_ME.
# Não use estas senhas fictícias em um ambiente compartilhado.
# Para a API executada no host, copie as variáveis necessárias para backend/.env.
NODE_ENV=development
API_PORT=3001
WEB_PORT=3000
API_INTERNAL_URL=http://localhost:3001
APP_ORIGIN=http://localhost:3000

# PostgreSQL local opcional. Runtime restrito e owner são papéis distintos.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=vertice_grc
POSTGRES_OWNER_USER=vertice_owner
POSTGRES_APP_USER=vertice_app
POSTGRES_SUPERUSER_PASSWORD=CHANGE_ME_LOCAL_SUPERUSER_PASSWORD
POSTGRES_OWNER_PASSWORD=CHANGE_ME_LOCAL_OWNER_PASSWORD
POSTGRES_APP_PASSWORD=CHANGE_ME_LOCAL_APP_PASSWORD
# Codifique caracteres especiais da senha em URLs e mantenha os valores consistentes.
DATABASE_URL=postgresql://vertice_app:CHANGE_ME_LOCAL_APP_PASSWORD@localhost:5433/vertice_grc?schema=public
# Ative somente na ferramenta de administração/migração, fora dos containers de runtime.
# DATABASE_MIGRATION_URL=postgresql://vertice_owner:CHANGE_ME_LOCAL_OWNER_PASSWORD@localhost:5433/vertice_grc?schema=public
# Com a API no Compose e o perfil local-db ativo, use postgres:5432 em DATABASE_URL.

REDIS_HOST_PORT=6379
REDIS_URL=redis://localhost:6379
SESSION_COOKIE_NAME=vgrc_session
# Desenvolvimento HTTP local. Produção exige HTTPS e SESSION_COOKIE_SECURE=true.
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_LIFETIME_HOURS=12

PASSWORD_MIN_LENGTH=12
PASSWORD_REQUIRE_COMPLEXITY=true
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=2
ARGON2_PARALLELISM=1

LOG_LEVEL=info
LOG_PRETTY=false
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100
AUTH_RATE_LIMIT_ACCOUNT_ATTEMPTS=5
AUTH_RATE_LIMIT_ORIGIN_ATTEMPTS=50
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AUTH_LOCKOUT_MINUTES=15

ATTACHMENT_STORAGE_DRIVER=local
ATTACHMENT_STORAGE_PATH=./storage/attachments
ATTACHMENT_MAX_SIZE_BYTES=26214400
ATTACHMENT_ALLOWED_MIME_TYPES=application/pdf,image/png,image/jpeg,text/plain

# A API não executa seed automaticamente.
SEED_DEV_FIXTURES=false
SEED_ADMIN_EMAIL=admin@example.invalid
# Defina uma senha inédita antes de executar o seed administrativo.
# SEED_ADMIN_PASSWORD=CHANGE_ME_SEED_ADMIN_PASSWORD

# Serviços de teste isolados; nunca reutilize o banco da aplicação.
TEST_POSTGRES_HOST_PORT=5434
TEST_POSTGRES_DB=vertice_grc_test
TEST_REDIS_HOST_PORT=6380
# Ative ambas somente na configuração das suítes que usam banco.
# TEST_DATABASE_URL=postgresql://vertice_app:CHANGE_ME_LOCAL_APP_PASSWORD@localhost:5434/vertice_grc_test?schema=public
# TEST_DATABASE_MIGRATION_URL=postgresql://vertice_owner:CHANGE_ME_LOCAL_OWNER_PASSWORD@localhost:5434/vertice_grc_test?schema=public
