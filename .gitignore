# Claude Code local settings (may contain credentials/auth tokens)
.claude/settings.local.json

# Dependencies
node_modules/

# Env files
.env
.env.local
.env.*.local

# Build output
dist/
build/
.next/
*.tsbuildinfo

# Logs
*.log
npm-debug.log*

# Test output
coverage/
playwright-report/
test-results/

# Local attachment storage (FileStorageProvider local adapter, ADR-010)
storage/

# Intermediate UI review captures (CLAUDE.md §18.13). The representative
# before/after pairs live in docs/reviews/ui/{baseline,after}/ and are tracked;
# per-wave captures are working artifacts of the refinement loop, regenerable
# with apps/web/scripts/ui-capture.mjs, and would otherwise add megabytes of
# near-duplicate PNGs to the history.
docs/reviews/ui/wave*/

# Impeccable design-hook dedup cache — machine-local, regenerated on every run
.impeccable/hook.cache.json

# UI review artifacts - keep only representative documentation
docs/reviews/ui/*/
!docs/reviews/ui/baseline/
!docs/reviews/ui/after/
!docs/reviews/ui/after-dark/
!docs/reviews/ui/after-narrow/
!docs/reviews/ui/decisions/

# Machine-specific bundled binaries
.claude/skills/impeccable/scripts/bin/